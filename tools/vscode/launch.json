{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Erp API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Host/Erp.Api/bin/Debug/net10.0/Erp.Api.dll",
      "cwd": "${workspaceFolder}/src/Host/Erp.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5227"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/scalar"
      },
      "stopAtEntry": false,
      "console": "internalConsole"
    }
  ]
}
