@inherits LayoutComponentBase
@inject Erp.Api.Components.Shared.Forms.Shortcuts Shortcuts
@inject IJSRuntime JS
@inject Erp.Api.Infrastructure.AppSession Session
@inject NavigationManager Nav

<MudRTLProvider RightToLeft="true">
    <MudThemeProvider Theme="_theme" />
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />

    <MudLayout>
        <MudAppBar Elevation="0" Class="no-print" Dense="true" Color="Color.Primary">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                           OnClick="() => _drawerOpen = !_drawerOpen" aria-label="منو" />
            <MudLink Href="/" Color="Color.Inherit" Underline="Underline.None" Class="mr-2"><MudText Typo="Typo.h6">Erp</MudText></MudLink>
            <MudSpacer />
            <GlobalSearch />
            <MudSpacer />
            @if (Session.Info is { } info)
            {
                <span class="appbar-company" title="شرکت جاری">
                    <MudIcon Icon="@Icons.Material.Outlined.Business" Size="Size.Small" Style="vertical-align:middle" /> @info.CompanyTitle
                </span>
                <MudMenu AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" Dense="true" aria-label="حساب کاربری">
                    <ActivatorContent>
                        <MudChip T="string" Color="Color.Inherit" Variant="Variant.Outlined" Icon="@Icons.Material.Outlined.AccountCircle"
                                 Style="color:inherit; border-color:rgba(255,255,255,.5)">@info.DisplayName</MudChip>
                    </ActivatorContent>
                    <ChildContent>
                        <MudMenuItem Icon="@Icons.Material.Outlined.Person" Disabled="true">
                            <span dir="ltr">@info.UserName</span>@(info.IsSystemAdmin ? " · مدیر سیستم" : "")
                        </MudMenuItem>
                        <MudDivider />
                        <MudMenuItem Icon="@Icons.Material.Outlined.SwapHoriz" OnClick="@(() => Go(Erp.Api.Infrastructure.Auth.CompanyPath))">تغییر شرکت</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Outlined.Password" OnClick="@(() => Go(Erp.Api.Infrastructure.Auth.ChangePasswordPath))">تغییر رمز عبور</MudMenuItem>
                        @if (Session.IsSystemAdmin)
                        {
                            <MudMenuItem Icon="@Icons.Material.Outlined.Api" Href="/scalar" Target="_blank">مستندات API</MudMenuItem>
                        }
                        <MudDivider />
                        <MudMenuItem Icon="@Icons.Material.Outlined.Logout" OnClick="@(() => Go(Erp.Api.Infrastructure.Auth.LogoutPath))">خروج</MudMenuItem>
                    </ChildContent>
                </MudMenu>
            }
        </MudAppBar>

        <MudDrawer Class="no-print" @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="1" Variant="DrawerVariant.Responsive">
            <MudNavMenu>
                @foreach (var node in AppMenu.Tree.Where(n => n.IsVisible(Session)))
                {
                    @MenuNode(node)
                }
            </MudNavMenu>
        </MudDrawer>

        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4">
                @Body
            </MudContainer>
        </MudMainContent>
    </MudLayout>
</MudRTLProvider>

@code {
    private bool _drawerOpen = true;

    private bool _idleStarted;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Shortcuts.AttachAsync(JS);
        // خروج خودکار بعد از بی‌کاری (از تنظیمات امنیتی)
        if (!_idleStarted && Session.Info is { } info)
        {
            _idleStarted = true;
            await JS.InvokeVoidAsync("erpIdle.start", info.IdleMinutes);
        }
    }

    /// <summary>صفحه‌های حساب کاربری بیرون از اتصال تعاملی‌اند (کوکی عوض می‌شود).</summary>
    private void Go(string url) => Nav.NavigateTo(url, forceLoad: true);

    private RenderFragment MenuNode(AppMenu.Node node) => __builder =>
    {
        if (node.Children is { } children)
        {
            <MudNavGroup Title="@node.Title" Icon="@node.Icon" Expanded="@node.Expanded">
                @foreach (var child in children.Where(c => c.IsVisible(Session)))
                {
                    @MenuNode(child)
                }
            </MudNavGroup>
        }
        else
        {
            <MudNavLink Href="@node.Href" Match="@node.Match" Icon="@node.Icon">@node.Title</MudNavLink>
        }
    };

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#1F5F8B",
            Secondary = "#2E8B6E",
            AppbarBackground = "#1F5F8B",
            Background = "#F6F7F9",
        },
        Typography = new Typography
        {
            Default = new DefaultTypography { FontFamily = ["Vazirmatn", "Tahoma", "sans-serif"] },
            H4 = new H4Typography { FontFamily = ["Vazirmatn", "Tahoma", "sans-serif"], FontSize = "1.6rem", FontWeight = "700" },
            H5 = new H5Typography { FontFamily = ["Vazirmatn", "Tahoma", "sans-serif"], FontSize = "1.3rem", FontWeight = "700" },
            H6 = new H6Typography { FontFamily = ["Vazirmatn", "Tahoma", "sans-serif"], FontWeight = "600" },
            Button = new ButtonTypography { FontFamily = ["Vazirmatn", "Tahoma", "sans-serif"], TextTransform = "none" },
        },
        LayoutProperties = new LayoutProperties { DefaultBorderRadius = "8px" }
    };
}
