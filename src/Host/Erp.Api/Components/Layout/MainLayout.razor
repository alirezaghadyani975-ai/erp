@inherits LayoutComponentBase

<MudRTLProvider RightToLeft="true">
    <MudThemeProvider Theme="_theme" />
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />

    <MudLayout>
        <MudAppBar Elevation="0" Class="no-print" Dense="true" Color="Color.Primary">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                           OnClick="() => _drawerOpen = !_drawerOpen" aria-label="منو" />
            <MudText Typo="Typo.h6" Class="mr-2">Erp</MudText>
            
            <MudSpacer />
            <MudLink Href="/scalar" Target="_blank" Color="Color.Inherit" Typo="Typo.body2">API</MudLink>
        </MudAppBar>

        <MudDrawer Class="no-print" @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="1" Variant="DrawerVariant.Responsive">
            <MudNavMenu>
                <MudNavGroup Title="مالی" Icon="@Icons.Material.Outlined.AccountBalanceWallet" Expanded="true">
                    <MudNavGroup Title="حسابداری" Icon="@Icons.Material.Outlined.Calculate" Expanded="true">
                        <MudNavLink Href="/vouchers" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.ReceiptLong">اسناد حسابداری</MudNavLink>
                        <MudNavLink Href="/vouchers/new" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.NoteAdd">سند جدید</MudNavLink>
                        <MudNavGroup Title="گزارش‌ها" Icon="@Icons.Material.Outlined.Assessment" Expanded="true">
                            <MudNavLink Href="/reports/trial-balance" Icon="@Icons.Material.Outlined.TableChart">تراز آزمایشی</MudNavLink>
                            <MudNavLink Href="/reports/ledger" Icon="@Icons.Material.Outlined.MenuBook">دفتر معین و تفصیلی</MudNavLink>
                        </MudNavGroup>
                        <MudNavGroup Title="تعاریف" Icon="@Icons.Material.Outlined.Tune" Expanded="false">
                            <MudNavLink Href="/accounts" Icon="@Icons.Material.Outlined.AccountTree">کدینگ حساب‌ها</MudNavLink>
                            <MudNavLink Href="/detail-types" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Category">گروه‌ها و حساب‌های تفصیلی</MudNavLink>
                            <MudNavLink Href="/fiscal-years" Icon="@Icons.Material.Outlined.CalendarMonth">سال و دوره مالی</MudNavLink>
                        </MudNavGroup>
                    </MudNavGroup>
                    <MudNavGroup Title="بهای تمام‌شده" Icon="@Icons.Material.Outlined.Factory" Expanded="false">
                        <MudNavLink Href="/costing/centers" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Hub">مراکز هزینه</MudNavLink>
                        <MudNavLink Href="/costing/factors" Icon="@Icons.Material.Outlined.Category">عوامل هزینه</MudNavLink>
                        <MudNavLink Href="/costing/center-types" Icon="@Icons.Material.Outlined.Lan">انواع مرکز هزینه</MudNavLink>
                    </MudNavGroup>
                </MudNavGroup>
                <MudDivider Class="my-2" />
                <MudNavGroup Title="اطلاعات پایه" Icon="@Icons.Material.Outlined.Storage" Expanded="true">
                    <MudNavLink Href="/persons" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.People">اشخاص</MudNavLink>
                    <MudNavLink Href="/base/roles" Icon="@Icons.Material.Outlined.Label">نقش‌های اشخاص</MudNavLink>
                    <MudNavLink Href="/base/lookups" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.ListAlt">جدول‌های پایه</MudNavLink>
                    <MudNavLink Href="/base/banks" Icon="@Icons.Material.Outlined.AccountBalance">بانک‌ها</MudNavLink>
                </MudNavGroup>
            </MudNavMenu>
        </MudDrawer>

        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4">
                @Body
            </MudContainer>
        </MudMainContent>
    </MudLayout>
</MudRTLProvider>

@code {
    private bool _drawerOpen = true;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#1F5F8B",
            Secondary = "#2E8B6E",
            AppbarBackground = "#1F5F8B",
            Background = "#F6F7F9",
        },
        Typography = new Typography
        {
            Default = new DefaultTypography { FontFamily = ["Vazirmatn", "Tahoma", "sans-serif"] },
            H4 = new H4Typography { FontFamily = ["Vazirmatn", "Tahoma", "sans-serif"], FontSize = "1.6rem", FontWeight = "700" },
            H5 = new H5Typography { FontFamily = ["Vazirmatn", "Tahoma", "sans-serif"], FontSize = "1.3rem", FontWeight = "700" },
            H6 = new H6Typography { FontFamily = ["Vazirmatn", "Tahoma", "sans-serif"], FontWeight = "600" },
            Button = new ButtonTypography { FontFamily = ["Vazirmatn", "Tahoma", "sans-serif"], TextTransform = "none" },
        },
        LayoutProperties = new LayoutProperties { DefaultBorderRadius = "8px" }
    };
}
