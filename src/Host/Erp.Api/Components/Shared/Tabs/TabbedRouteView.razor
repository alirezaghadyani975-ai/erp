@* جایگزین RouteView: هر مسیر را به تب‌ها می‌سپارد و همه تب‌های باز را داخل چیدمان نگه می‌دارد. *@
@implements IDisposable
@inject TabService Tabs
@inject NavigationManager Nav
@inject Erp.Api.Infrastructure.AppSession Session

<LayoutView Layout="DefaultLayout">
@if (_ready)
{
    <div class="tab-strip no-print">
        @foreach (var tab in Tabs.Tabs)
        {
            var key = tab.Key;
            var active = key == Tabs.ActiveKey;
            var home = key == TabService.HomeKey;
            <div class="tab-item @(active ? "active" : "") @(home ? "tab-home" : "")" title="@tab.Title"
                 @onclick="() => Tabs.Activate(key)" @onmouseup="e => { if (e.Button == 1) Tabs.Close(key); }">
                @if (home)
                {
                    <MudIcon Icon="@Icons.Material.Outlined.Home" Size="Size.Small" />
                }
                <span class="tab-title">@tab.Title</span>
                @if (!home)
                {
                    <span class="tab-close" @onclick="() => Tabs.Close(key)" @onclick:stopPropagation="true" aria-label="بستن">×</span>
                }
            </div>
        }
        @if (Tabs.Tabs.Count > 2)
        {
            <MudTooltip Text="بستن بقیه تب‌ها">
                <MudIconButton Icon="@Icons.Material.Outlined.ClearAll" Size="Size.Small" Class="tab-close-others"
                               OnClick="() => Tabs.CloseOthers(Tabs.ActiveKey!)" aria-label="بستن بقیه تب‌ها" />
            </MudTooltip>
        }
    </div>

    @if (Tabs.Active is { } current)
    {
        <PageTitle>@current.Title</PageTitle>
    }

    @foreach (var tab in Tabs.Tabs)
    {
        <div @key="@($"{tab.Key}#{tab.Version}")" class="tab-page" style="@(tab.Key == Tabs.ActiveKey ? null : "display:none")">
            <CascadingValue Value="new TabContext(tab.Key)" IsFixed="true">
                <DynamicComponent Type="tab.PageType" Parameters="tab.Parameters" />
            </CascadingValue>
        </div>
    }
}
</LayoutView>

@code {
    [Parameter, EditorRequired] public Microsoft.AspNetCore.Components.RouteData RouteData { get; set; } = null!;
    [Parameter] public Type DefaultLayout { get; set; } = null!;

    private bool _ready;

    protected override async Task OnInitializedAsync()
    {
        Tabs.Changed += OnChanged;
        // نشست (مجوزها) پیش از ساختن صفحه‌ها بارگذاری می‌شود تا صفحه‌ها بتوانند منو و دکمه‌ها را با مجوز نشان دهند
        try { await Session.EnsureAsync(); }
        catch (Erp.Api.Infrastructure.SessionExpiredException) { }
        if (!Session.IsAuthenticated)
        {
            Nav.NavigateTo($"{Erp.Api.Infrastructure.Auth.LoginPath}?expired=1", forceLoad: true);
            return;
        }
        _ready = true;
    }

    protected override void OnParametersSet()
    {
        if (!_ready) return;
        // باز کردن مستقیم آدرس صفحه‌ای که کاربر مجوزش را ندارد
        var route = AppMenu.CanOpen(Session, Nav.ToAbsoluteUri(Nav.Uri).AbsolutePath)
            ? RouteData
            : new Microsoft.AspNetCore.Components.RouteData(typeof(AccessDenied), new Dictionary<string, object?>());
        Tabs.Open(route, Nav.Uri);
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Tabs.Changed -= OnChanged;
}
