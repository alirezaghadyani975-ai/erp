@* نمایش، چاپ و اکسل یک گزارش جدولی (ReportTable) با سرستون گروهی، ردیف جمع و سطح دوم باز و بسته‌شونده.
   چاپ همان حالتی را می‌گیرد که روی صفحه است؛ اکسل همیشه هر دو سطح را دارد. *@
@inject IJSRuntime JS

@if (Report is { } r)
{
    @if (r.Landscape)
    {
        <style>@@media print { @@page { size: A4 landscape; margin: 8mm; } }</style>
    }
    <div class="report-sheet">
        <div class="report-sheet-head">
            <div>
                <div class="report-sheet-title">@r.Title</div>
                @foreach (var s in r.Subtitle) { <div class="report-sheet-sub">@s</div> }
            </div>
            <div class="no-print d-flex gap-2">
                @if (r.HasChildren)
                {
                    <MudButton Variant="Variant.Text" StartIcon="@(_allOpen ? Icons.Material.Outlined.UnfoldLess : Icons.Material.Outlined.UnfoldMore)"
                               OnClick="ToggleAll">@(_allOpen ? "بستن همه" : $"باز کردن همه{(r.ChildTitle is null ? "" : $" ({r.ChildTitle})")}")</MudButton>
                }
                <ExcelButton Build="BuildExcel" Disabled="r.Rows.Count == 0" />
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Print" Disabled="r.Rows.Count == 0"
                           OnClick="@(() => JS.InvokeVoidAsync("print").AsTask())">چاپ</MudButton>
            </div>
        </div>
        @if (r.Rows.Count == 0)
        {
            <MudText Class="pa-4" Color="Color.Secondary">داده‌ای برای این گزارش نیست.</MudText>
        }
        else
        {
            var grouped = r.Columns.Any(c => c.Group is not null);
            <div class="report-scroll">
                <table class="report-grid">
                    <thead>
                        @if (grouped)
                        {
                            <tr>
                                @foreach (var block in Blocks(r.Columns))
                                {
                                    if (block.Group is null)
                                    {
                                        foreach (var c in block.Columns) { <th rowspan="2" class="@Css(c)">@c.Title</th> }
                                    }
                                    else
                                    {
                                        <th colspan="@block.Columns.Count" class="group">@block.Group</th>
                                    }
                                }
                            </tr>
                            <tr>
                                @foreach (var c in r.Columns.Where(c => c.Group is not null)) { <th class="@Css(c)">@c.Title</th> }
                            </tr>
                        }
                        else
                        {
                            <tr>@foreach (var c in r.Columns) { <th class="@Css(c)">@c.Title</th> }</tr>
                        }
                    </thead>
                    <tbody>
                        @foreach (var row in r.Rows)
                        {
                            var hasChildren = row.Children is { Count: > 0 };
                            var open = hasChildren && _open.Contains(row);
                            <tr class="@(hasChildren ? "report-parent" : null)" @onclick="() => Toggle(row)">
                                @for (var i = 0; i < r.Columns.Count; i++)
                                {
                                    var c = r.Columns[i];
                                    <td class="@Css(c)">
                                        @if (i == 0 && hasChildren)
                                        {
                                            <MudIcon Icon="@(open ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronLeft)" Size="Size.Small"
                                                     Class="no-print" Style="vertical-align:middle" />
                                        }
                                        @Text(c, row[c.Key])
                                    </td>
                                }
                            </tr>
                            @if (open)
                            {
                                foreach (var child in row.Children!)
                                {
                                    <tr class="report-child">
                                        @foreach (var c in r.Columns) { <td class="@Css(c)">@Text(c, child[c.Key])</td> }
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                    @if (r.Columns.Any(c => c.Sum && c.Kind is ReportColumnKind.Amount or ReportColumnKind.Number))
                    {
                        <tfoot>
                            <tr>
                                @for (var i = 0; i < r.Columns.Count; i++)
                                {
                                    var c = r.Columns[i];
                                    <td class="@Css(c)">
                                        @if (i == 0) { <span>جمع (@r.Rows.Count)</span> }
                                        else if (c.Sum && c.Kind is ReportColumnKind.Amount or ReportColumnKind.Number) { @Text(c, r.Total(c.Key)) }
                                    </td>
                                }
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
        }
    </div>
}

@code {
    [Parameter] public ReportTable? Report { get; set; }

    private readonly HashSet<ReportRow> _open = new(ReferenceEqualityComparer.Instance);
    private ReportTable? _shown;
    private bool _allOpen;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(Report, _shown)) return;
        _shown = Report;
        _open.Clear();
        _allOpen = false;
    }

    private void Toggle(ReportRow row)
    {
        if (row.Children is not { Count: > 0 }) return;
        if (!_open.Remove(row)) _open.Add(row);
    }

    private void ToggleAll()
    {
        _allOpen = !_allOpen;
        _open.Clear();
        if (_allOpen && Report is { } r) foreach (var row in r.Rows.Where(x => x.Children is { Count: > 0 })) _open.Add(row);
    }

    private sealed record Block(string? Group, List<ReportColumn> Columns);

    /// <summary>ستون‌های پشت‌سرهم با یک گروه، یک بلوک سرستون.</summary>
    private static IEnumerable<Block> Blocks(List<ReportColumn> columns)
    {
        Block? current = null;
        foreach (var c in columns)
        {
            if (current is null || current.Group != c.Group || c.Group is null)
            {
                if (current is not null) yield return current;
                current = new Block(c.Group, [c]);
            }
            else current.Columns.Add(c);
        }
        if (current is not null) yield return current;
    }

    private static string Css(ReportColumn c) => c.Kind switch
    {
        ReportColumnKind.Amount or ReportColumnKind.Number or ReportColumnKind.Percent => "num",
        ReportColumnKind.Code => "code",
        _ => ""
    };

    private static string Text(ReportColumn c, object? v) => v switch
    {
        null => "",
        decimal d when c.Kind == ReportColumnKind.Amount => d == 0 ? "" : Format.Amount(d),
        decimal d when c.Kind == ReportColumnKind.Percent => d.ToString("#,0.#", System.Globalization.CultureInfo.InvariantCulture) + "٪",
        decimal d => d == 0 ? "" : d.ToString("#,0.##", System.Globalization.CultureInfo.InvariantCulture),
        _ => v.ToString() ?? ""
    };

    private ExcelFile? BuildExcel()
    {
        if (Report is not { } r) return null;
        // سطح دوم زیر ردیف خودش با ستون «سطح» برای فیلتر در اکسل
        var rows = r.Rows.SelectMany(x => new[] { (Level: 1, Row: x) }.Concat((x.Children ?? []).Select(ch => (Level: 2, Row: ch)))).ToList();
        var columns = new List<ExcelColumn<(int Level, ReportRow Row)>>();
        if (r.HasChildren) columns.Add(new("سطح", x => x.Level, ExcelKind.Number));
        columns.AddRange(r.Columns.Select(c => new ExcelColumn<(int Level, ReportRow Row)>(
            c.Group is null ? c.Title : $"{c.Group} - {c.Title}", x => x.Row[c.Key],
            c.Kind switch
            {
                ReportColumnKind.Amount => ExcelKind.Amount,
                ReportColumnKind.Number or ReportColumnKind.Percent => ExcelKind.Number,
                ReportColumnKind.Code => ExcelKind.Code,
                _ => ExcelKind.Text
            })));
        return ExcelExport.Build(r.Title, r.Subtitle, columns, rows);
    }
}
