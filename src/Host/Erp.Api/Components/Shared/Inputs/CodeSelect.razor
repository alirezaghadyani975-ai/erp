@* انتخاب از جدول کد ثابت (مثلاً جدول‌های راهنمای فایل مالیات حقوق). *@
<MudSelect T="byte?" Value="Value" ValueChanged="ValueChanged" Label="@Label" Clearable="!Required" Required="Required"
           RequiredError="@($"{Label} الزامی است.")" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
    @foreach (var (key, title) in Items)
    {
        <MudSelectItem T="byte?" Value="key">@key — @title</MudSelectItem>
    }
</MudSelect>

@code {
    [Parameter] public byte? Value { get; set; }
    [Parameter] public EventCallback<byte?> ValueChanged { get; set; }
    [Parameter, EditorRequired] public IReadOnlyDictionary<byte, string> Items { get; set; } = new Dictionary<byte, string>();
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public bool Required { get; set; }
}
