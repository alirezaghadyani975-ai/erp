@* انتخاب معین با جستجوی کد یا عنوان *@
@inject Backend Backend

<MudAutocomplete T="AccountDto" Value="Value" ValueChanged="OnChanged" SearchFunc="Search"
                 ToStringFunc="@(a => a is null ? null : $"{a.Code} - {a.Title}")"
                 Placeholder="کد یا نام معین" Variant="Variant.Outlined" Margin="Margin.Dense"
                 Dense="true" MaxItems="30" DebounceInterval="250" ResetValueOnEmptyText="true"
                 SelectOnActivation="true" Disabled="Disabled" Error="Error" ErrorText="@ErrorText"
                 AdornmentIcon="@Icons.Material.Outlined.Search">
    <ItemTemplate Context="a">
        <span class="code ml-2">@a.Code</span> @a.Title
    </ItemTemplate>
    <NoItemsTemplate><MudText Typo="Typo.body2" Class="pa-2">معینی پیدا نشد.</MudText></NoItemsTemplate>
</MudAutocomplete>

@code {
    [Parameter] public AccountDto? Value { get; set; }
    [Parameter] public EventCallback<AccountDto?> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Error { get; set; }
    [Parameter] public string? ErrorText { get; set; }

    private async Task<IEnumerable<AccountDto>> Search(string? term, CancellationToken ct)
    {
        var result = await Backend.Run<AccountService, List<AccountDto>>(s => s.SearchPostableAsync(term, ct));
        return result.Value ?? [];
    }

    private Task OnChanged(AccountDto? value) => ValueChanged.InvokeAsync(value);
}
