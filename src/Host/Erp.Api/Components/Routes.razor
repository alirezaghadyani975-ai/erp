<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        @if (IsAccountPage(routeData.PageType))
        {
            <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.AccountLayout)" />
        }
        else
        {
            <TabbedRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        }
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(Layout.MainLayout)">
            <MudAlert Severity="Severity.Warning">صفحه پیدا نشد.</MudAlert>
        </LayoutView>
    </NotFound>
</Router>

@code {
    // صفحه‌های حساب کاربری (ورود و ...) بدون تب و منو، با چیدمان ساده
    private static bool IsAccountPage(Type page) =>
        page.IsDefined(typeof(Microsoft.AspNetCore.Components.ExcludeFromInteractiveRoutingAttribute), inherit: true);
}
