@page "/treasury/imprest/new"
@page "/treasury/imprest/{Id:long}"
@inject Backend Backend
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject TabService Tabs

<TabTitle Text="@Heading" />

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
    return;
}

<FormWithList Title="صورت‌هزینه تنخواه" Load="LoadSideAsync" NewUrl="/treasury/imprest/new" CurrentUrl="@SelfUrl" Version="_listVersion">
<MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-3" Spacing="2">
    <MudText Typo="Typo.h5">@Heading</MudText>
    @if (_voucher is not null)
    {
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Outlined.ReceiptLong"
                 Color="@Format.StatusColor((VoucherStatus)_voucher.Status)" OnClick="OpenVoucher">
            سند @_voucher.TempNo — @Format.Status((VoucherStatus)_voucher.Status)
        </MudChip>
    }
    <MudSpacer />
    @if (_voucher is not null)
    {
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.ReceiptLong" OnClick="OpenVoucher">مشاهده سند</MudButton>
    }
    @if (!IsNew && !Locked)
    {
        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Outlined.Delete" OnClick="DeleteAsync" Disabled="_saving">حذف</MudButton>
    }
    @if (!Locked)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAsync" Disabled="_saving">
            @(IsNew ? "ثبت و صدور سند" : "ذخیره و اصلاح سند")
        </MudButton>
    }
</MudStack>

@if (Locked)
{
    <MudAlert Severity="Severity.Info" Class="mb-3">سند حسابداری این فرم دائم شده است؛ فرم فقط قابل مشاهده است (اصلاح فقط با سند اصلاحی).</MudAlert>
}
@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3" ShowCloseIcon="true" CloseIconClicked="() => _error = null">@_error</MudAlert>
}

<MudPaper Class="pa-4 mb-3" Elevation="1">
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="6" md="3">
            <PersianDateField @bind-Value="_date" Label="تاریخ" Required="true" Disabled="Locked" />
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudSelect T="int?" @bind-Value="_fundId" Label="تنخواه‌گردان" Required="true" Disabled="Locked" Dense="true"
                       Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                @foreach (var f in _funds.Where(f => f.IsActive || f.Id == _fundId))
                {
                    <MudSelectItem T="int?" Value="f.Id">@f.Title <span class="select-hint">@f.HolderName · مانده @Format.Amount(f.Balance)</span></MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="5">
            <MudTextField @bind-Value="_description" Label="شرح" MaxLength="500" Disabled="Locked" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Class="pa-3 mb-3" Elevation="1">
    <MudText Typo="Typo.subtitle1" Class="mb-2"><b>ردیف‌های هزینه</b></MudText>
    <table class="voucher-grid">
        <thead>
            <tr>
                <th style="width:3%">#</th>
                <th style="width:30%">عامل هزینه</th>
                <th style="width:24%">مرکز هزینه</th>
                <th style="width:15%">مبلغ</th>
                <th>شرح</th>
                <th style="width:4%"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var (line, i) in _lines.Select((l, i) => (l, i)))
            {
                <tr>
                    <td class="code">@(i + 1)</td>
                    <td>
                        <MudAutocomplete T="CostFactorDto" Value="line.Factor" ValueChanged="f => FactorChanged(line, f)" SearchFunc="SearchFactors"
                                         ToStringFunc="@(f => f is null ? null : $"{f.Code} - {f.Title}")" Placeholder="کد یا نام عامل"
                                         ResetValueOnEmptyText="true" Dense="true" MaxItems="40" Disabled="Locked"
                                         Variant="Variant.Outlined" Margin="Margin.Dense">
                            <ItemTemplate Context="f">
                                <span class="code ml-2">@f.Code</span> @f.Title
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Inline="true" Class="mr-1">(@Titles.Of(f.Nature))</MudText>
                            </ItemTemplate>
                        </MudAutocomplete>
                        @if (AccountHint(line) is { } hint)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@hint</MudText>
                        }
                    </td>
                    <td>
                        @if (line.Factor?.Nature == CostNature.Finance)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">هزینه مالی مرکز ندارد</MudText>
                        }
                        else
                        {
                            <MudSelect T="int?" Value="line.CenterId" ValueChanged="c => line.CenterId = c" Placeholder="مرکز هزینه" Dense="true"
                                       Disabled="Locked" Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var c in _centers.Where(c => c.IsActive || c.Id == line.CenterId).OrderBy(c => c.Function).ThenBy(c => c.Title))
                                {
                                    <MudSelectItem T="int?" Value="c.Id">@c.Title <span class="select-hint">(@Titles.Of(c.Function))</span></MudSelectItem>
                                }
                            </MudSelect>
                        }
                    </td>
                    <td>
                        <MudNumericField T="decimal" @bind-Value="line.Amount" Format="#,0.####" HideSpinButtons="true" Min="0" Class="num"
                                         Disabled="Locked" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </td>
                    <td>
                        <MudTextField @bind-Value="line.Description" MaxLength="500" Disabled="Locked" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </td>
                    <td>
                        @if (!Locked)
                        {
                            <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error"
                                           Disabled="_lines.Count == 1" OnClick="() => _lines.Remove(line)" aria-label="حذف ردیف" />
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (!Locked)
    {
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add" OnClick="() => _lines.Add(new LineModel())" Class="mt-1">ردیف جدید</MudButton>
    }

    <MudDivider Class="my-3" />
    <MudGrid Spacing="2" Justify="Justify.FlexEnd">
        <MudItem xs="12" sm="4" md="3">
            <MudField Label="جمع ردیف‌ها" Variant="Variant.Text" Margin="Margin.Dense"><span class="num">@Format.Amount(LinesTotal)</span></MudField>
        </MudItem>
        <MudItem xs="12" sm="4" md="4">
            <VatBox @bind-Value="_vat" Date="@_date" BaseAmount="LinesTotal" Disabled="Locked" />
        </MudItem>
        <MudItem xs="12" sm="4" md="3">
            <MudField Label="مبلغ کل (بستانکار تنخواه)" Variant="Variant.Text" Margin="Margin.Dense"><b class="num">@Format.Amount(LinesTotal + _vat)</b></MudField>
        </MudItem>
    </MudGrid>
</MudPaper>
</FormWithList>

@code {
    [Parameter] public long? Id { get; set; }

    private sealed class LineModel
    {
        public CostFactorDto? Factor { get; set; }
        public int? CenterId { get; set; }
        public decimal Amount { get; set; }
        public string? Description { get; set; }
    }

    private bool IsNew => Id is null;
    private string? SelfUrl => Id is long id ? $"/treasury/imprest/{id}" : null;
    private string Heading => IsNew ? "صورت‌هزینه تنخواه جدید" : $"صورت‌هزینه تنخواه {Format.No(_docNo)}";
    private bool Locked => _voucher?.Status == 3;
    private decimal LinesTotal => _lines.Sum(l => l.Amount);

    private List<CostFactorDto> _factors = [];
    private List<CostCenterListItemDto> _centers = [];
    private List<LineModel> _lines = [new()];
    private List<ImprestFundDto> _funds = [];
    private int? _fundId;
    private string? _date = Format.Today();
    private string? _description;
    private decimal _vat;
    private int _docNo;
    private TreasuryVoucherDto? _voucher;
    private bool _loading = true;
    private int _listVersion;
    private bool _saving;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _factors = (await Backend.Run<CostFactorService, List<CostFactorDto>>(s => s.SearchAsync(null, null, true, default))).Value ?? [];
        _centers = (await Backend.Run<CostCenterService, List<CostCenterListItemDto>>(s => s.GetAllAsync(true, default))).Value ?? [];
        _funds = (await Backend.Run<TreasurySetupService, List<ImprestFundDto>>(s => s.GetImprestFundsAsync(true, default))).Value ?? [];
        if (Id is long id) await LoadAsync(id);
        else _fundId ??= _funds.Count(f => f.IsActive) == 1 ? _funds.First(f => f.IsActive).Id : null;
        _loading = false;
    }

    private async Task LoadAsync(long id)
    {
        var r = await Backend.Run<ImprestSettlementService, ImprestSettlementDto>(s => s.GetAsync(id, default));
        if (!r.Success) { _error = r.Error; return; }
        var x = r.Value!;
        (_docNo, _date, _fundId, _description, _vat, _voucher) = (x.DocNo, x.Date, x.ImprestFundId, x.Description, x.VatAmount, x.Voucher);
        _lines = x.Lines.Select(l => new LineModel
        {
            Factor = _factors.FirstOrDefault(f => f.Id == l.CostFactorId),
            CenterId = l.CostCenterId,
            Amount = l.Amount,
            Description = l.Description
        }).ToList();
    }

    private async Task<List<SideItem>> LoadSideAsync()
    {
        var r = await Backend.Run<ImprestSettlementService, List<ImprestSettlementListItemDto>>(s => s.ListAsync(null, null, default));
        return (r.Value ?? []).Select(x => new SideItem($"/treasury/imprest/{x.Id}", $"{Format.No(x.DocNo)} — {x.FundTitle}",
            x.Date, Format.Amount(x.Total))).ToList();
    }

    private Task<IEnumerable<CostFactorDto>> SearchFactors(string? term, CancellationToken ct)
    {
        IEnumerable<CostFactorDto> list = _factors.Where(f => f.IsActive);
        term = PersianText.NormalizeOrNull(term);
        if (term is not null) list = list.Where(f => f.Title.Contains(term) || (f.Code?.StartsWith(term) ?? false));
        return Task.FromResult(list);
    }

    private void OpenVoucher()
    {
        if (_voucher is not null) Tabs.Go($"/vouchers/{_voucher.VoucherId}");
    }

    private static void FactorChanged(LineModel line, CostFactorDto? factor)
    {
        line.Factor = factor;
        if (factor?.Nature == CostNature.Finance) line.CenterId = null;
    }

    /// <summary>معین هزینه‌ای که ردیف در آن ثبت می‌شود: کل از گروه عامل، معین از وظیفه مرکز.</summary>
    private string? AccountHint(LineModel line)
    {
        if (line.Factor is null) return null;
        if (line.Factor.Nature == CostNature.Finance) return $"در {Titles.Of(line.Factor.Nature)}";
        var center = _centers.FirstOrDefault(c => c.Id == line.CenterId);
        return center is null ? $"در {Titles.Of(line.Factor.Nature)}" : $"در {Titles.Of(line.Factor.Nature)} - {Titles.Of(center.Function)}";
    }

    private async Task SaveAsync()
    {
        _error = null;
        if (_date is null) { _error = "تاریخ الزامی است."; return; }
        if (_fundId is null) { _error = "تنخواه‌گردان را انتخاب کنید."; return; }
        var empty = _lines.FindIndex(l => l.Factor is null);
        if (empty >= 0) { _error = $"ردیف {empty + 1}: عامل هزینه را انتخاب کنید."; return; }

        var request = new SaveImprestSettlementRequest(_date, _fundId.Value, _vat, _description,
            _lines.Select(l => new ImprestLineRequest(l.Factor!.Id, l.CenterId, l.Amount, l.Description)).ToList());

        _saving = true;
        if (Id is long id)
        {
            var r = await Backend.Run<ImprestSettlementService>(s => s.UpdateAsync(id, request, default));
            _saving = false;
            if (!r.Success) { _error = r.Error; return; }
            Snackbar.Add("فرم ذخیره شد و سند حسابداری‌اش اصلاح شد.", Severity.Success);
            _listVersion++;
            await LoadAsync(id);
        }
        else
        {
            var r = await Backend.Run<ImprestSettlementService, long>(s => s.CreateAsync(request, default));
            _saving = false;
            if (!r.Success) { _error = r.Error; return; }
            Snackbar.Add("فرم ثبت شد و سند حسابداری موقت صادر شد.", Severity.Success);
            Tabs.Go($"/treasury/imprest/{r.Value}");
        }
    }

    private async Task DeleteAsync()
    {
        if (Id is not long id) return;
        if (!await Dialogs.DeleteAsync($"صورت‌هزینه تنخواه شماره {Format.No(_docNo)}", "سند حسابداری آن هم حذف می‌شود.")) return;
        var r = await Backend.Run<ImprestSettlementService>(s => s.DeleteAsync(id, default));
        if (!r.Success) { _error = r.Error; return; }
        Snackbar.Add("فرم و سند حسابداری‌اش حذف شد.", Severity.Success);
        Tabs.CloseCurrentAndGo("/treasury/imprest");
    }
}
