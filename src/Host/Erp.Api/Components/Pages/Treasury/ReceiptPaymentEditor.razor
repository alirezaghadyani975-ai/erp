@* فرم مشترک دریافت و پرداخت؛ صفحه‌های ReceiptPage و PaymentPage آن را با IsPayment باز می‌کنند. *@
@inject Erp.Api.Infrastructure.AppSession Session
@inject Backend Backend
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject TabService Tabs

<TabTitle Text="@Heading" />

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
    return;
}

<FormWithList Title="@Noun" Load="LoadSideAsync" NewUrl="@($"{BaseUrl}/new")" CurrentUrl="@SelfUrl" Version="_listVersion" Editing="Dirty">
<FormToolbar Title="@Heading" Permission="@(IsPayment ? "trs.payment" : "trs.receipt")" AuditEntity="@(IsPayment ? "Payment" : "Receipt")" AuditId="Id" IsNew="IsNew" Editing="_editing" CanEdit="!Locked" CanDelete="!Locked" Busy="_saving"
             SaveText="@(_opening ? "ذخیره" : IsNew ? "ثبت و صدور سند" : "ذخیره و اصلاح سند")" VoucherId="_voucher?.VoucherId"
             LockReason="@(Locked ? _lockReason ?? "سند حسابداری این فرم دائم شده است؛ فرم فقط قابل مشاهده است." : null)"
             OnNew="@(() => Tabs.Go($"{BaseUrl}/new"))" OnEdit="() => _editing = true" OnSave="SaveAsync" OnCancel="CancelAsync" OnDelete="DeleteAsync">
    <Chips>
        @if (_opening)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Icon="@Icons.Material.Outlined.History">اول دوره — بدون سند</MudChip>
        }
        @if (_voucher is not null)
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Outlined.ReceiptLong"
                     Color="@Format.StatusColor((VoucherStatus)_voucher.Status)">سند @_voucher.TempNo — @Format.Status((VoucherStatus)_voucher.Status)</MudChip>
        }
    </Chips>
</FormToolbar>

@if (_editing && (_boxes.All(b => !b.IsActive) || _banks.All(b => !b.IsActive) || _types.All(t => !t.IsActive)))
{
    <MudAlert Severity="Severity.Warning" Class="mb-3">
        @(MissingSetup)
        @if (Session.Has(TreasuryPermissions.Setup))
        {
            <span> — از <MudLink OnClick="@(() => Tabs.Go("/treasury/setup"))">تعاریف خزانه‌داری</MudLink> تعریف کنید.</span>
        }
        else
        {
            <span> — اگر لازم دارید، از مدیر سیستم بخواهید دسترسی بدهد.</span>
        }
    </MudAlert>
}
@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3" ShowCloseIcon="true" CloseIconClicked="() => _error = null">@_error</MudAlert>
}

<div class="@(ReadOnly ? "view-mode" : null)">
<MudPaper Class="pa-4 mb-3" Elevation="1">
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="6" md="3">
            <PersianDateField @bind-Value="_date" Label="تاریخ" Required="true" Disabled="ReadOnly" />
        </MudItem>
        <MudItem xs="12" sm="6" md="5">
            <PersonPicker @bind-PersonId="_personId" PersonName="@_personName" Label="@(IsPayment ? "دریافت‌کننده (طرف حساب)" : "پرداخت‌کننده (طرف حساب)")"
                          Required="true" Disabled="ReadOnly" />
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudSelect T="short?" @bind-Value="_typeId" Label="@(IsPayment ? "نوع پرداخت" : "نوع دریافت")" Required="true" Disabled="ReadOnly"
                       Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                @foreach (var t in _types.Where(t => t.IsActive || t.Id == _typeId))
                {
                    <MudSelectItem T="short?" Value="t.Id">@t.Title <span class="select-hint">(@t.AccountCode)</span></MudSelectItem>
                }
            </MudSelect>
            @if (_types.FirstOrDefault(t => t.Id == _typeId) is { } tp)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">طرف حساب در معین @tp.AccountCode - @tp.AccountTitle</MudText>
            }
        </MudItem>
        <MudItem xs="12" md="9">
            <MudTextField @bind-Value="_description" Label="شرح" MaxLength="500" Disabled="ReadOnly" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudTooltip Text="@($"چک‌های در جریان پیش از شروع کار با نرم‌افزار؛ فقط ردیف چک و بدون سند، چون مانده‌شان در سند افتتاحیه است.")">
                <MudCheckBox @bind-Value="_opening" Label="اول دوره (بدون سند)" Disabled="ReadOnly" Dense="true" Color="Color.Secondary" />
            </MudTooltip>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Class="pa-3 mb-3" Elevation="1">
    <MudText Typo="Typo.subtitle1" Class="mb-2"><b>ردیف‌ها</b></MudText>
    <table class="voucher-grid">
        <thead>
            <tr>
                <th style="width:3%">#</th>
                <th style="width:13%">ابزار</th>
                <th style="width:24%">@(IsPayment ? "از صندوق / حساب" : "به صندوق / حساب")</th>
                <th style="width:15%">مبلغ</th>
                <th style="width:14%">شماره پیگیری</th>
                <th>شرح</th>
                <th style="width:4%"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var (line, i) in _lines.Select((l, i) => (l, i)))
            {
                <tr>
                    <td class="code">@(i + 1)</td>
                    <td>
                        <MudSelect T="Instrument" Value="line.Instrument" ValueChanged="v => InstrumentChanged(line, v)" Dense="true" Disabled="ReadOnly"
                                   Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var ins in Instruments)
                            {
                                <MudSelectItem T="Instrument" Value="ins">@InstrumentTitle(ins)</MudSelectItem>
                            }
                        </MudSelect>
                    </td>
                    <td>
                        @if (UsesBox(line.Instrument))
                        {
                            <MudSelect T="int?" @bind-Value="line.CashBoxId" Placeholder="صندوق" Dense="true" Disabled="ReadOnly"
                                       Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var b in _boxes.Where(b => b.IsActive || b.Id == line.CashBoxId))
                                {
                                    <MudSelectItem T="int?" Value="b.Id">@b.Title <span class="select-hint code">@b.Code</span></MudSelectItem>
                                }
                            </MudSelect>
                        }
                        else if (line.Instrument == Instrument.SpendCheque)
                        {
                            <MudSelect T="long?" Value="line.ReceivedChequeId" ValueChanged="v => ChequeChosen(line, v)" Placeholder="چک در صندوق"
                                       Dense="true" Disabled="ReadOnly" Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var c in SpendOptions(line))
                                {
                                    <MudSelectItem T="long?" Value="c.Id">@ChequeText(c)</MudSelectItem>
                                }
                            </MudSelect>
                        }
                        else
                        {
                            <MudSelect T="int?" Value="line.BankAccountId" ValueChanged="v => BankChanged(line, v)" Placeholder="حساب بانکی" Dense="true"
                                       Disabled="ReadOnly" Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var b in _banks.Where(b => b.IsActive || b.Id == line.BankAccountId))
                                {
                                    <MudSelectItem T="int?" Value="b.Id">@b.Title <span class="select-hint code">@b.AccountNo</span></MudSelectItem>
                                }
                            </MudSelect>
                        }
                    </td>
                    <td>
                        <MudNumericField T="decimal" @bind-Value="line.Amount" Format="#,0.####" HideSpinButtons="true" Min="0" Class="num"
                                         Disabled="@(ReadOnly || line.Instrument == Instrument.SpendCheque)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </td>
                    <td>
                        @if (line.Instrument is Instrument.Cash or Instrument.Bank)
                        {
                            <MudTextField @bind-Value="line.RefNo" MaxLength="50" Disabled="ReadOnly" Class="code" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        }
                    </td>
                    <td>
                        <MudTextField @bind-Value="line.Description" MaxLength="500" Disabled="ReadOnly" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </td>
                    <td>
                        @if (!ReadOnly)
                        {
                            <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error"
                                           Disabled="_lines.Count == 1" OnClick="() => _lines.Remove(line)" aria-label="حذف ردیف" />
                        }
                    </td>
                </tr>
                @if (line.Instrument == Instrument.Cheque)
                {
                    <tr class="cheque-row">
                        <td></td>
                        <td colspan="6">
                            <MudGrid Spacing="1">
                                @if (IsPayment)
                                {
                                    <MudItem xs="6" md="4">
                                        <MudSelect T="long?" Value="line.LeafId" ValueChanged="v => LeafChosen(line, v)" Label="برگ دسته‌چک" Dense="true"
                                                   Disabled="@(ReadOnly || line.BankAccountId is null)" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                   HelperText="@(line.BankAccountId is null ? "اول حساب بانکی را انتخاب کنید" : null)">
                                            @foreach (var leaf in LeafOptions(line))
                                            {
                                                <MudSelectItem T="long?" Value="leaf.Id"><span class="code">@leaf.SerialNo</span> <span class="select-hint">@leaf.BookTitle</span></MudSelectItem>
                                            }
                                        </MudSelect>
                                        @if (!ReadOnly && line.BankAccountId is int ba && LeafOptions(line).Count == 0)
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Warning">برگ سفیدی برای این حساب نیست؛ <MudLink Typo="Typo.caption" OnClick="@(() => Tabs.Go("/treasury/instruments"))">تعریف دسته‌چک</MudLink></MudText>
                                        }
                                    </MudItem>
                                }
                                else
                                {
                                    <MudItem xs="6" md="2"><MudTextField @bind-Value="line.Serial" Label="سریال چک" MaxLength="30" Disabled="ReadOnly" Class="code" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                }
                                <MudItem xs="6" md="3"><MudTextField @bind-Value="line.Sayad" Label="شناسه صیاد (۱۶ رقم)" MaxLength="16" Disabled="ReadOnly" Class="code" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                <MudItem xs="6" md="3"><PersianDateField @bind-Value="line.Due" Label="سررسید" Required="true" Disabled="ReadOnly" /></MudItem>
                                @if (!IsPayment)
                                {
                                    <MudItem xs="6" md="2"><BankSelect @bind-Value="line.ChequeBankId" /></MudItem>
                                    <MudItem xs="6" md="2"><MudTextField @bind-Value="line.Branch" Label="شعبه" MaxLength="100" Disabled="ReadOnly" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                    <MudItem xs="6" md="5"><MudTextField @bind-Value="line.Drawer" Label="صادرکننده" MaxLength="200" Disabled="ReadOnly" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                    <MudItem xs="6" md="3"><MudTextField @bind-Value="line.AccountNo" Label="شماره حساب صادرکننده" MaxLength="30" Disabled="ReadOnly" Class="code" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                }
                                @if (line.Status is { } st)
                                {
                                    <MudItem xs="12"><MudText Typo="Typo.caption" Color="Color.Secondary">وضعیت چک: @st</MudText></MudItem>
                                }
                            </MudGrid>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
    @if (!ReadOnly)
    {
        <MudStack Row="true" Spacing="1" Class="mt-1" Wrap="Wrap.Wrap">
            @foreach (var ins in Instruments)
            {
                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add" OnClick="() => AddLine(ins)">@InstrumentTitle(ins)</MudButton>
            }
        </MudStack>
    }

    <MudDivider Class="my-3" />
    <TotalsBar Items="@(_lines.GroupBy(l => l.Instrument).OrderBy(g => g.Key).Select(g => (InstrumentTitle(g.Key), g.Sum(l => l.Amount))).ToList())"
               Total="_lines.Sum(l => l.Amount)" TotalLabel="@($"جمع {Noun}")" />
</MudPaper>
</div>
</FormWithList>

@code {
    [Parameter] public bool IsPayment { get; set; }
    [Parameter] public long? Id { get; set; }

    private sealed class LineModel
    {
        public Instrument Instrument { get; set; } = Instrument.Cash;
        public int? CashBoxId { get; set; }
        public int? BankAccountId { get; set; }
        public long? ReceivedChequeId { get; set; }
        public decimal Amount { get; set; }
        public string? RefNo { get; set; }
        public string? Description { get; set; }
        public string? Serial { get; set; }
        public string? Sayad { get; set; }
        public string? Due { get; set; }
        public short? ChequeBankId { get; set; }
        public string? Branch { get; set; }
        public string? Drawer { get; set; }
        public string? AccountNo { get; set; }
        public string? Status { get; set; }
        public long? LeafId { get; set; }
    }

    private bool IsNew => Id is null;
    private string MissingSetup => string.Join("، ", new[]
    {
        _boxes.Any(b => b.IsActive) ? null : "صندوقی",
        _banks.Any(b => b.IsActive) ? null : "حساب بانکی‌ای",
        _types.Any(t => t.IsActive) ? null : $"نوع {Noun}ی"
    }.Where(x => x is not null)) + " تعریف نشده یا در دسترس شما نیست";
    private string Noun => IsPayment ? "پرداخت" : "دریافت";
    private string BaseUrl => IsPayment ? "/treasury/payments" : "/treasury/receipts";
    private string? SelfUrl => Id is long id ? $"{BaseUrl}/{id}" : null;
    private string Heading => IsNew ? $"{Noun} جدید" : $"{Noun} {Format.No(_docNo)}";
    private bool Locked => _lockReason is not null || _voucher?.Status == 3;
    private bool ReadOnly => !_editing || Locked;
    private bool Dirty => _editing && !IsNew;
    private Instrument[] Instruments => IsPayment
        ? [Instrument.Cash, Instrument.Bank, Instrument.Cheque, Instrument.SpendCheque]
        : [Instrument.Cash, Instrument.Bank, Instrument.Cheque];

    private List<TransactionTypeDto> _types = [];
    private List<CashBoxDto> _boxes = [];
    private List<TreasuryBankAccountDto> _banks = [];
    private List<ChequeDto> _spendable = [];
    private List<LineModel> _lines = [];
    private string? _date = Format.Today();
    private int? _personId;
    private string? _personName;
    private short? _typeId;
    private string? _description;
    private bool _opening;
    private int _docNo;
    private TreasuryVoucherDto? _voucher;
    private string? _lockReason;
    private bool _loading = true;
    private bool _saving;
    private bool _editing;
    /// <summary>برگ‌های سفید دسته‌چک هر حساب بانکی (پرداخت).</summary>
    private readonly Dictionary<int, List<LeafOption>> _leaves = [];
    /// <summary>برگ چک‌های ذخیره‌شده همین فرم (دیگر سفید نیستند).</summary>
    private readonly List<LeafOption> _ownLeaves = [];
    private int _listVersion;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _error = null;
        _leaves.Clear();
        var kind = IsPayment ? TransactionKind.Payment : TransactionKind.Receipt;
        _types = (await Backend.Run<TreasurySetupService, List<TransactionTypeDto>>(s => s.GetTypesAsync(kind, true, default))).Value ?? [];
        _boxes = (await Backend.Run<TreasurySetupService, List<CashBoxDto>>(s => s.GetCashBoxesAsync(true, default))).Value ?? [];
        _banks = (await Backend.Run<TreasurySetupService, List<TreasuryBankAccountDto>>(s => s.GetBankAccountsAsync(true, default))).Value ?? [];
        if (IsPayment)
            _spendable = (await Backend.Run<PaymentService, List<ChequeDto>>(s => s.GetSpendableChequesAsync(default))).Value ?? [];
        if (Id is long id) await LoadAsync(id);
        else ResetNew();
        _editing = IsNew;
        _loading = false;
    }

    private void ResetNew()
    {
        (_personId, _personName, _description, _opening) = (null, null, null, false);
        _lines = [];
        _lines.Add(NewLine(Instrument.Cash));
        _typeId = _types.FirstOrDefault(t => t.IsActive)?.Id;
    }

    private async Task LoadAsync(long id)
    {
        var r = IsPayment
            ? await Backend.Run<PaymentService, ReceiptPaymentDto>(s => s.GetAsync(id, default))
            : await Backend.Run<ReceiptService, ReceiptPaymentDto>(s => s.GetAsync(id, default));
        if (!r.Success) { _error = r.Error; return; }
        var x = r.Value!;
        (_docNo, _date, _personId, _personName, _typeId, _description, _voucher, _lockReason, _opening) =
            (x.DocNo, x.Date, x.PersonId, x.PersonName, x.TypeId, x.Description, x.Voucher, x.LockReason, x.IsOpening);
        _lines = x.Lines.Select(l => new LineModel
        {
            Instrument = l.Instrument, CashBoxId = l.CashBoxId, BankAccountId = l.BankAccountId, ReceivedChequeId = l.ReceivedChequeId,
            Amount = l.Amount, RefNo = l.RefNo, Description = l.Description,
            Serial = l.Cheque?.SerialNo, Sayad = l.Cheque?.SayadId, Due = l.Cheque?.DueDate, ChequeBankId = l.Cheque?.BankId,
            Branch = l.Cheque?.Branch, Drawer = l.Cheque?.DrawerName, AccountNo = l.Cheque?.AccountNo,
            Status = l.Instrument == Instrument.Cheque ? l.Cheque?.StatusTitle : null,
            LeafId = l.Cheque?.LeafId
        }).ToList();
        _ownLeaves.Clear();
        if (IsPayment)
            foreach (var l in _lines.Where(l => l.Instrument == Instrument.Cheque && l.LeafId is not null))
            {
                _ownLeaves.Add(new LeafOption(l.LeafId!.Value, 0, "همین فرم", l.Serial ?? "?", l.BankAccountId, null));
                if (l.BankAccountId is int b) await EnsureLeavesAsync(b);
            }
        // چک خرج‌شده همین فرم دیگر در صندوق نیست؛ برای نمایش به فهرست اضافه می‌شود.
        foreach (var c in x.Lines.Where(l => l.Instrument == Instrument.SpendCheque && l.Cheque is not null).Select(l => l.Cheque!))
            if (_spendable.All(s => s.Id != c.Id)) _spendable.Add(c);
    }

    private async Task<List<SideItem>> LoadSideAsync()
    {
        var r = IsPayment
            ? await Backend.Run<PaymentService, List<ReceiptPaymentListItemDto>>(s => s.ListAsync(null, null, null, default))
            : await Backend.Run<ReceiptService, List<ReceiptPaymentListItemDto>>(s => s.ListAsync(null, null, null, default));
        return (r.Value ?? []).Select(x => new SideItem($"{BaseUrl}/{x.Id}", $"{Format.No(x.DocNo)} — {x.PersonName}",
            $"{x.Date} · {x.TypeTitle}", Format.Amount(x.Total))).ToList();
    }

    private static string InstrumentTitle(Instrument i) => i switch
    {
        Instrument.Cash => "نقد",
        Instrument.Bank => "بانکی",
        Instrument.Cheque => "چک",
        Instrument.SpendCheque => "خرج چک دریافتی",
        _ => i.ToString()
    };

    private bool UsesBox(Instrument i) => i == Instrument.Cash || (i == Instrument.Cheque && !IsPayment);

    private static string ChequeText(ChequeDto c) =>
        $"{c.SerialNo} · {c.DueDate} · {Format.Amount(c.Amount)}{(c.BankTitle is null ? "" : $" · {c.BankTitle}")}";

    private IEnumerable<ChequeDto> SpendOptions(LineModel line) =>
        _spendable.Where(c => c.Id == line.ReceivedChequeId || _lines.All(l => l.ReceivedChequeId != c.Id));

    private LineModel NewLine(Instrument ins)
    {
        var last = _lines.LastOrDefault();
        var line = new LineModel { Instrument = ins };
        line.CashBoxId = last?.CashBoxId ?? (_boxes.Count(b => b.IsActive) == 1 ? _boxes.First(b => b.IsActive).Id : null);
        line.BankAccountId = last?.BankAccountId ?? (_banks.Count(b => b.IsActive) == 1 ? _banks.First(b => b.IsActive).Id : null);
        if (ins == Instrument.Cheque) line.Drawer = _personName;
        return line;
    }

    private async Task AddLine(Instrument ins)
    {
        var line = NewLine(ins);
        _lines.Add(line);
        if (IsPayment && ins == Instrument.Cheque && line.BankAccountId is int b) await BankChanged(line, b);
    }

    private async Task InstrumentChanged(LineModel line, Instrument ins)
    {
        line.Instrument = ins;
        if (ins != Instrument.SpendCheque) line.ReceivedChequeId = null;
        else line.Amount = 0;
        if (IsPayment && ins == Instrument.Cheque && line.BankAccountId is int b) await BankChanged(line, b);
        if (ins != Instrument.Cheque) line.LeafId = null;
    }

    private async Task EnsureLeavesAsync(int bankAccountId)
    {
        if (_leaves.ContainsKey(bankAccountId)) return;
        var r = await Backend.Run<InstrumentService, List<LeafOption>>(s => s.GetBlankLeavesAsync(InstrumentKind.ChequeBook, bankAccountId, default));
        _leaves[bankAccountId] = r.Value ?? [];
    }

    /// <summary>برگ‌های قابل انتخاب ردیف: سفیدهای همان حساب + برگ خود ردیف، بدون برگ‌هایی که ردیف دیگر برداشته.</summary>
    private List<LeafOption> LeafOptions(LineModel line)
    {
        if (line.BankAccountId is not int b) return [];
        var list = _ownLeaves.Where(o => o.BankAccountId == b).Concat(_leaves.GetValueOrDefault(b) ?? []);
        return list.Where(o => o.Id == line.LeafId || _lines.All(l => l == line || l.LeafId != o.Id)).DistinctBy(o => o.Id).ToList();
    }

    private async Task BankChanged(LineModel line, int? bankAccountId)
    {
        line.BankAccountId = bankAccountId;
        if (!IsPayment || line.Instrument != Instrument.Cheque) return;
        line.LeafId = null;
        if (bankAccountId is not int b) return;
        await EnsureLeavesAsync(b);
        var next = LeafOptions(line).FirstOrDefault(o => o.BookId != 0);
        if (next is not null) LeafChosen(line, next.Id);
    }

    private void LeafChosen(LineModel line, long? leafId)
    {
        line.LeafId = leafId;
        line.Serial = LeafOptions(line).FirstOrDefault(o => o.Id == leafId)?.SerialNo;
    }

    private void ChequeChosen(LineModel line, long? id)
    {
        line.ReceivedChequeId = id;
        line.Amount = _spendable.FirstOrDefault(c => c.Id == id)?.Amount ?? 0;
    }

    private async Task CancelAsync()
    {
        _error = null;
        if (Id is long id) { await LoadAsync(id); _editing = false; }
        else ResetNew();
    }

    private async Task SaveAsync()
    {
        _error = null;
        if (_date is null) { _error = "تاریخ الزامی است."; return; }
        if (_personId is null) { _error = "طرف حساب را انتخاب کنید."; return; }
        if (_typeId is null) { _error = $"نوع {Noun} را انتخاب کنید."; return; }
        for (var i = 0; i < _lines.Count; i++)
        {
            var l = _lines[i];
            if (IsPayment && l.Instrument == Instrument.Cheque && l.LeafId is null)
            { _error = $"ردیف {i + 1}: برگ دسته‌چک را انتخاب کنید."; return; }
            if (l.Instrument == Instrument.Cheque && (string.IsNullOrWhiteSpace(l.Serial) || l.Due is null))
            { _error = $"ردیف {i + 1}: سریال و سررسید چک الزامی است."; return; }
        }

        var request = new SaveReceiptPaymentRequest(_date, _personId.Value, _typeId.Value, _description,
            _lines.Select(l => new TreasuryLineRequest(l.Instrument,
                UsesBox(l.Instrument) ? l.CashBoxId : null,
                l.Instrument is Instrument.Bank || (l.Instrument == Instrument.Cheque && IsPayment) ? l.BankAccountId : null,
                l.Amount, l.Instrument is Instrument.Cash or Instrument.Bank ? l.RefNo : null, l.Description,
                l.Instrument == Instrument.Cheque ? new ChequeInput(l.Serial!.Trim(), l.Sayad, l.Due!, l.ChequeBankId, l.Branch, l.Drawer, l.AccountNo, IsPayment ? l.LeafId : null) : null,
                l.Instrument == Instrument.SpendCheque ? l.ReceivedChequeId : null)).ToList(), _opening);

        _saving = true;
        if (Id is long id)
        {
            var r = IsPayment
                ? await Backend.Run<PaymentService>(s => s.UpdateAsync(id, request, default))
                : await Backend.Run<ReceiptService>(s => s.UpdateAsync(id, request, default));
            _saving = false;
            if (!r.Success) { _error = r.Error; return; }
            Snackbar.Add("فرم ذخیره شد و سند حسابداری‌اش اصلاح شد.", Severity.Success);
            _listVersion++;
            _leaves.Clear();
            await LoadAsync(id);
            _editing = false;
        }
        else
        {
            var r = IsPayment
                ? await Backend.Run<PaymentService, long>(s => s.CreateAsync(request, default))
                : await Backend.Run<ReceiptService, long>(s => s.CreateAsync(request, default));
            _saving = false;
            if (!r.Success) { _error = r.Error; return; }
            Snackbar.Add("فرم ثبت شد و سند حسابداری موقت صادر شد.", Severity.Success);
            Tabs.Go($"{BaseUrl}/{r.Value}");
        }
    }

    private async Task DeleteAsync()
    {
        if (Id is not long id) return;
        if (!await Dialogs.DeleteAsync($"{Noun} شماره {Format.No(_docNo)}", "سند حسابداری و چک‌های آن هم حذف می‌شود.")) return;
        var r = IsPayment
            ? await Backend.Run<PaymentService>(s => s.DeleteAsync(id, default))
            : await Backend.Run<ReceiptService>(s => s.DeleteAsync(id, default));
        if (!r.Success) { _error = r.Error; return; }
        Snackbar.Add("فرم و سند حسابداری‌اش حذف شد.", Severity.Success);
        Tabs.CloseCurrentAndGo(BaseUrl);
    }
}
