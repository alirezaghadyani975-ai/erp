@page "/inventory/costing"
@using Erp.Inventory.Domain
@inject Backend Backend
@inject TabService Tabs
@inject ISnackbar Snackbar

<TabTitle Text="محاسبه بهای تمام‌شده" />

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1" Spacing="2">
    <MudText Typo="Typo.h5">محاسبه بهای تمام‌شده</MudText>
    <MudSpacer />
    <MudSelect T="short?" Value="_yearId" ValueChanged="async y => { _yearId = y; await LoadAsync(); }" Label="سال مالی"
               Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="width:160px">
        @foreach (var y in _years)
        {
            <MudSelectItem T="short?" Value="y.Id">@y.Title</MudSelectItem>
        }
    </MudSelect>
    <MudIconButton Icon="@Icons.Material.Outlined.Refresh" OnClick="LoadAsync" aria-label="به‌روزرسانی" />
</MudStack>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
    بهای هر حواله با میانگین موزون متحرک همان کالا در همان انبار حساب می‌شود و سند ماه (بهای تمام‌شده فروش، هزینه مصرف و برگشت‌ها)
    صادر یا بازنویسی می‌شود. «محاسبه تا این ماه» ماه‌های قبلیِ محاسبه‌نشده یا تغییرکرده را هم به ترتیب حساب می‌کند.
    هیچ بهایی از فی قبلی یا تقریبی حساب نمی‌شود: اطلاعات ناقص (مثل رسید خرید بدون فاکتور) صفر لحاظ و بعد از محاسبه گزارش می‌شود؛
    با کامل شدن اطلاعات، ماه «نیازمند محاسبه دوباره» می‌شود.
</MudText>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3" ShowCloseIcon="true" CloseIconClicked="() => _error = null">@_error</MudAlert>
}

@if (_warnings is { Count: > 0 })
{
    <MudPaper Class="pa-3 mb-3" Elevation="1" Style="border-inline-start:4px solid var(--mud-palette-warning)">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Outlined.ReportProblem" Color="Color.Warning" />
            <MudText Typo="Typo.subtitle1"><b>گزارش اطلاعات ناقص (@_warnings.Count ردیف) — بهای این ردیف‌ها صفر لحاظ شد</b></MudText>
            <MudSpacer />
            <ExcelButton Build="BuildWarnings" />
            <MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small" OnClick="() => _warnings = null" aria-label="بستن گزارش" />
        </MudStack>
        <MudTable T="(string Period, CostWarningDto W)" Items="_warnings" Dense="true" Hover="true" Elevation="0"
                  OnRowClick="@(a => Open(a.Item.W))" RowStyle="cursor:pointer">
            <HeaderContent>
                <MudTh>ماه</MudTh>
                <MudTh>تاریخ</MudTh>
                <MudTh>سند</MudTh>
                <MudTh>کالا</MudTh>
                <MudTh Style="text-align:left">مقدار</MudTh>
                <MudTh>اطلاعات ناقص</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Period</MudTd>
                <MudTd><span class="code">@context.W.Date</span></MudTd>
                <MudTd>@context.W.Type.Title() <span class="code">@Format.No(context.W.DocNo)</span> ردیف @context.W.RowNo</MudTd>
                <MudTd>@context.W.Item</MudTd>
                <MudTd Class="num">@context.W.Quantity.ToString("#,0.######")</MudTd>
                <MudTd>@context.W.Problem</MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}

<MudPaper Class="pa-3" Elevation="1">
    @if (_running)
    {
        <MudProgressLinear Indeterminate="true" Class="mb-2" />
    }
    <MudTable T="CostPeriodDto" Items="_periods" Dense="true" Hover="true" Elevation="0" Loading="_loading">
        <HeaderContent>
            <MudTh>دوره</MudTh>
            <MudTh>از</MudTh>
            <MudTh>تا</MudTh>
            <MudTh>وضعیت</MudTh>
            <MudTh Style="text-align:left">بهای صادره</MudTh>
            <MudTh Style="text-align:left">بهای وارده</MudTh>
            <MudTh>سند</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Title</MudTd>
            <MudTd><span class="code">@context.StartDate</span></MudTd>
            <MudTd><span class="code">@context.EndDate</span></MudTd>
            <MudTd>
                @switch (context.Status)
                {
                    case CostRunStatus.Computed:
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">محاسبه‌شده (@context.RunAt)</MudChip>
                        break;
                    case CostRunStatus.Stale:
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">نیازمند محاسبه دوباره</MudChip>
                        break;
                    default:
                        if (context.HasDocs)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">محاسبه‌نشده</MudChip>
                        }
                        else
                        {
                            <span class="select-hint">بدون سند انبار</span>
                        }
                        break;
                }
            </MudTd>
            <MudTd Class="num">@(context.Status is null ? "" : Format.Amount(context.IssuedAmount))</MudTd>
            <MudTd Class="num">@(context.Status is null ? "" : Format.Amount(context.ReceivedAmount))</MudTd>
            <MudTd>
                @if (context.VoucherId is long v)
                {
                    <MudChip T="string" Size="Size.Small" Color="@Format.StatusColor((VoucherStatus)context.VoucherStatus!.Value)"
                             OnClick="@(() => Tabs.Go($"/vouchers/{v}"))">@context.VoucherTempNo — @Format.Status((VoucherStatus)context.VoucherStatus!.Value)</MudChip>
                }
            </MudTd>
            <MudTd Style="text-align:left">
                @if (context.HasDocs || context.Status is not null)
                {
                    <MudButton Size="Size.Small" Variant="@(context.Status == CostRunStatus.Computed ? Variant.Text : Variant.Filled)" Color="Color.Primary"
                               StartIcon="@Icons.Material.Outlined.Calculate" Disabled="@(_running || context.VoucherStatus == 3)"
                               OnClick="() => RunAsync(context)">
                        @(context.Status == CostRunStatus.Computed ? "محاسبه دوباره" : "محاسبه تا این ماه")
                    </MudButton>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText Class="pa-4">برای این سال دوره مالی تعریف نشده است.</MudText></NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private List<FiscalYearDto> _years = [];
    private List<CostPeriodDto> _periods = [];
    private short? _yearId;
    private bool _loading = true, _running;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _years = (await Backend.Run<FiscalYearService, List<FiscalYearDto>>(s => s.GetAllAsync(default))).Value ?? [];
        var today = Format.Today();
        _yearId = _years.FirstOrDefault(y => string.CompareOrdinal(y.StartDate, today) <= 0 && string.CompareOrdinal(y.EndDate, today) >= 0)?.Id
                  ?? _years.LastOrDefault()?.Id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_yearId is not short year) { _loading = false; return; }
        _loading = true;
        var r = await Backend.Run<StockCostingService, List<CostPeriodDto>>(s => s.PeriodsAsync(year, default));
        if (r.Success) _periods = r.Value!; else _error = r.Error;
        _loading = false;
    }

    private async Task RunAsync(CostPeriodDto period)
    {
        _error = null;
        _running = true;
        var r = await Backend.Run<StockCostingService, List<CostRunResultDto>>(s => s.RunUpToAsync(period.PeriodId, default));
        _running = false;
        if (!r.Success) { _error = r.Error; await LoadAsync(); return; }
        _warnings = r.Value!.SelectMany(x => x.Warnings.Select(w => (x.PeriodTitle, w))).ToList();
        Snackbar.Add($"{r.Value!.Count} ماه محاسبه شد" + (_warnings.Count > 0 ? $"؛ {_warnings.Count} ردیف اطلاعات ناقص دارد و صفر لحاظ شد (گزارش بالای جدول)." : "."),
            _warnings.Count > 0 ? Severity.Warning : Severity.Success);
        await LoadAsync();
    }

    private List<(string Period, CostWarningDto W)>? _warnings;

    private void Open(CostWarningDto w) =>
        Tabs.Go(w.Type.IsReceipt() ? $"/inventory/receipts/{w.DocId}" : $"/inventory/issues/{w.DocId}");

    private ExcelFile BuildWarnings() => ExcelExport.Build("اطلاعات ناقص بهای تمام‌شده", [],
    [
        new ExcelColumn<(string Period, CostWarningDto W)>("ماه", r => r.Period),
        new("تاریخ", r => r.W.Date, ExcelKind.Code),
        new("سند", r => $"{r.W.Type.Title()} {Format.No(r.W.DocNo)} ردیف {r.W.RowNo}"),
        new("کالا", r => r.W.Item),
        new("مقدار", r => r.W.Quantity, ExcelKind.Amount),
        new("اطلاعات ناقص", r => r.W.Problem),
    ], _warnings!);
}
