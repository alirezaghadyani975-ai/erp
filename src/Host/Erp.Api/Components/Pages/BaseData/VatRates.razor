@page "/base/vat-rates"
@inject Backend Backend
@inject VatRateCache RateCache
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<TabTitle Text="نرخ مالیات و عوارض" />

<MudText Typo="Typo.h5" Class="mb-1">نرخ مالیات و عوارض ارزش افزوده</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
    برای هر سال درصد مالیات و درصد عوارض را تعریف کنید. فرم‌هایی مثل شناسایی هزینه و صورت‌هزینه تنخواه مبلغ ارزش افزوده را
    از روی سال تاریخ فرم خودکار حساب می‌کنند (مبلغ در فرم قابل اصلاح است).
</MudText>

<MudPaper Class="pa-3" Elevation="1" Style="max-width:720px">
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.End" Class="mb-3" Wrap="Wrap.Wrap">
        <MudNumericField T="int?" @bind-Value="_year" Label="سال" Min="1390" Max="1500" HideSpinButtons="true" Class="code"
                         Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:120px" />
        <MudNumericField T="decimal" @bind-Value="_tax" Label="درصد مالیات" Min="0" Max="100" HideSpinButtons="true" Class="num"
                         Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:140px" />
        <MudNumericField T="decimal" @bind-Value="_toll" Label="درصد عوارض" Min="0" Max="100" HideSpinButtons="true" Class="num"
                         Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:140px" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAsync" Disabled="_year is null">ذخیره</MudButton>
    </MudStack>
    <MudSimpleTable Dense="true" Hover="true" Elevation="0">
        <thead><tr><th>سال</th><th>مالیات ٪</th><th>عوارض ٪</th><th>جمع ٪</th><th></th></tr></thead>
        <tbody>
            @foreach (var r in _rates)
            {
                <tr style="cursor:pointer" @onclick="() => Edit(r)">
                    <td class="code">@r.PersianYear</td>
                    <td class="num">@r.TaxPercent.ToString("0.##")</td>
                    <td class="num">@r.TollPercent.ToString("0.##")</td>
                    <td class="num"><b>@r.TotalPercent.ToString("0.##")</b></td>
                    <td style="text-align:left" @onclick:stopPropagation="true">
                        <MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => DeleteAsync(r)" aria-label="حذف" />
                    </td>
                </tr>
            }
            @if (_rates.Count == 0)
            {
                <tr><td colspan="5"><MudText Typo="Typo.body2" Class="pa-2">هنوز نرخی تعریف نشده است.</MudText></td></tr>
            }
        </tbody>
    </MudSimpleTable>
</MudPaper>

@code {
    private List<VatRateDto> _rates = [];
    private int? _year;
    private decimal _tax;
    private decimal _toll;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _year = PersianDate.PersianYear(DateOnly.FromDateTime(DateTime.Now));
        if (_rates.FirstOrDefault(r => r.PersianYear == _year) is { } current) Edit(current);
    }

    private async Task LoadAsync()
    {
        var r = await Backend.Run<VatRateService, List<VatRateDto>>(s => s.GetAllAsync(default));
        if (r.Success) _rates = r.Value!; else Snackbar.Add(r.Error!, Severity.Error);
    }

    private void Edit(VatRateDto r) => (_year, _tax, _toll) = (r.PersianYear, r.TaxPercent, r.TollPercent);

    private async Task SaveAsync()
    {
        if (_year is not int year) return;
        var r = await Backend.Run<VatRateService>(s => s.SaveAsync(year, _tax, _toll, default));
        RateCache.Invalidate();
        if (!r.Success) { Snackbar.Add(r.Error!, Severity.Error); return; }
        Snackbar.Add($"نرخ سال {year} ذخیره شد.", Severity.Success);
        await LoadAsync();
    }

    private async Task DeleteAsync(VatRateDto rate)
    {
        if (!await Dialogs.DeleteAsync($"نرخ سال {rate.PersianYear}", null)) return;
        var r = await Backend.Run<VatRateService>(s => s.DeleteAsync(rate.Id, default));
        if (!r.Success) { Snackbar.Add(r.Error!, Severity.Error); return; }
        await LoadAsync();
    }
}
