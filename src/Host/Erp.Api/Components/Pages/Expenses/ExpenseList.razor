@page "/expenses"
@inject Backend Backend
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<TabTitle Text="شناسایی هزینه" />

<MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-1" Spacing="2">
    <MudText Typo="Typo.h5">شناسایی هزینه</MudText>
    <MudSpacer />
    <MudIconButton Icon="@Icons.Material.Outlined.Refresh" OnClick="LoadAsync" aria-label="به‌روزرسانی" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/expenses/new">فرم جدید</MudButton>
</MudStack>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
    فاکتورهای خدماتی تأمین‌کنندگان: هزینه با عامل و مرکز هزینه شناسایی و بدهی به تأمین‌کننده ثبت می‌شود؛ پرداخت بعداً از خزانه‌داری.
    با ثبت فرم سند موقت خودکار صادر می‌شود و با اصلاح یا حذف فرم، سندش هم اصلاح یا حذف می‌شود.
</MudText>

<MudPaper Class="pa-3" Elevation="1">
    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="mb-2">
        <MudTextField T="string" @bind-Value="_term" Immediate="true" DebounceInterval="300" OnDebounceIntervalElapsed="_ => LoadAsync()"
                      Placeholder="تأمین‌کننده، شماره فاکتور یا شرح" Clearable="true"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:260px" />
        <div style="width:170px"><PersianDateField Value="_from" ValueChanged="async v => { _from = v; await LoadAsync(); }" Label="از تاریخ" /></div>
        <div style="width:170px"><PersianDateField Value="_to" ValueChanged="async v => { _to = v; await LoadAsync(); }" Label="تا تاریخ" /></div>
    </MudStack>

    <MudTable T="ExpenseInvoiceListItemDto" Items="_rows" Dense="true" Hover="true" Elevation="0" Loading="_loading"
              OnRowClick="@(a => Nav.NavigateTo($"/expenses/{a.Item!.Id}"))" RowStyle="cursor:pointer">
        <HeaderContent>
            <MudTh>شماره</MudTh>
            <MudTh>تاریخ</MudTh>
            <MudTh>تأمین‌کننده</MudTh>
            <MudTh>ش. فاکتور</MudTh>
            <MudTh>شرح</MudTh>
            <MudTh Style="text-align:left">هزینه</MudTh>
            <MudTh Style="text-align:left">ارزش افزوده</MudTh>
            <MudTh Style="text-align:left">جمع</MudTh>
            <MudTh>سند</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd><span class="code">@context.DocNo</span></MudTd>
            <MudTd><span class="code">@context.Date</span></MudTd>
            <MudTd>@context.SupplierName</MudTd>
            <MudTd><span class="code">@context.InvoiceNo</span></MudTd>
            <MudTd>@context.Description</MudTd>
            <MudTd Class="num">@Format.Amount(context.LinesTotal)</MudTd>
            <MudTd Class="num">@Format.Amount(context.VatAmount)</MudTd>
            <MudTd Class="num"><b>@Format.Amount(context.Total)</b></MudTd>
            <MudTd>
                @if (context.Voucher is { } v)
                {
                    <MudChip T="string" Size="Size.Small" Color="@Format.StatusColor((VoucherStatus)v.Status)">@v.TempNo — @Format.Status((VoucherStatus)v.Status)</MudChip>
                }
            </MudTd>
        </RowTemplate>
        <FooterContent>
            <MudTd colspan="5"><b>جمع (@_rows.Count فرم)</b></MudTd>
            <MudTd Class="num"><b>@Format.Amount(_rows.Sum(r => r.LinesTotal))</b></MudTd>
            <MudTd Class="num"><b>@Format.Amount(_rows.Sum(r => r.VatAmount))</b></MudTd>
            <MudTd Class="num"><b>@Format.Amount(_rows.Sum(r => r.Total))</b></MudTd>
            <MudTd />
        </FooterContent>
        <NoRecordsContent><MudText Class="pa-4">فرمی ثبت نشده است.</MudText></NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private List<ExpenseInvoiceListItemDto> _rows = [];
    private bool _loading = true;
    private string? _term;
    private string? _from;
    private string? _to;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var r = await Backend.Run<ExpenseInvoiceService, List<ExpenseInvoiceListItemDto>>(s => s.ListAsync(_term, _from, _to, default));
        if (r.Success) _rows = r.Value!; else Snackbar.Add(r.Error!, Severity.Error);
        _loading = false;
    }
}
