@page "/account/change-password"
@attribute [ExcludeFromInteractiveRouting]
@attribute [Authorize]
@inject AuthService AuthService
@inject SecuritySettingsService Settings
@inject NavigationManager Nav

<PageTitle>تغییر رمز عبور</PageTitle>
<h1 class="auth-h1">تغییر رمز عبور</h1>

@if (_forced)
{
    <div class="auth-info">برای ادامه، رمز عبور جدیدی انتخاب کنید (رمز اولیه یا بازنشانی‌شده باید عوض شود).</div>
}
@if (_message is not null)
{
    <div class="auth-alert" role="alert">@_message</div>
}

<EditForm Model="Input!" FormName="change-password" OnSubmit="ChangeAsync" method="post" class="auth-form">
    <input type="text" name="username" value="@Http.User.Identity?.Name" autocomplete="username" hidden />
    <label for="cur">رمز فعلی</label>
    <InputText id="cur" type="password" @bind-Value="Input!.Current" autocomplete="current-password" dir="ltr" required autofocus />
    <label for="new">رمز جدید</label>
    <InputText id="new" type="password" @bind-Value="Input!.New" autocomplete="new-password" dir="ltr" required />
    <label for="rep">تکرار رمز جدید</label>
    <InputText id="rep" type="password" @bind-Value="Input!.Repeat" autocomplete="new-password" dir="ltr" required />
    <p class="auth-hint">حداقل @_minLength نویسه، هم حرف و هم رقم، و بدون نام کاربری.</p>
    <button type="submit" class="auth-button">ذخیره رمز جدید</button>
</EditForm>
@if (!_forced)
{
    <p class="auth-links"><a href="/">بازگشت به برنامه</a></p>
}
<p class="auth-links"><a href="@Auth.LogoutPath">خروج</a></p>

@code {
    [CascadingParameter] private HttpContext Http { get; set; } = default!;
    [SupplyParameterFromForm] private PasswordInput? Input { get; set; }

    private string? _message;

    private bool _forced;
    private int _minLength = 8;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        _forced = Http.User.HasClaim(c => c.Type == ErpClaims.MustChangePassword);
        _minLength = (await Settings.GetAsync(Http.RequestAborted)).PasswordMinLength;
    }

    private async Task ChangeAsync()
    {
        if (Input!.New != Input!.Repeat)
        {
            _message = "رمز جدید و تکرار آن یکی نیستند.";
            return;
        }
        var userId = ErpClaims.UserIdOf(Http.User) ?? 0;
        var ip = Auth.IpOf(Http);
        Guid stamp;
        try
        {
            stamp = await AuthService.ChangePasswordAsync(userId, Input!.Current, Input!.New, ip, Http.RequestAborted);
        }
        catch (Exception ex) when (ex is Erp.SharedKernel.Domain.DomainException or Erp.SharedKernel.Domain.NotFoundException)
        {
            _message = ex.Message;
            return;
        }
        finally
        {
            Input = new();
        }

        // کوکی تازه با مهر امنیتی جدید (نشست‌های دیگر کاربر باطل می‌شوند)
        var user = Http.User;
        var company = user.FindFirst(ErpClaims.Company)?.Value;
        if (company is null)
        {
            var companies = await AuthService.CompaniesAsync(userId, Http.RequestAborted);
            if (companies.Count == 1) company = companies[0].Key;
        }
        await Auth.SignInAsync(Http, Auth.Principal(userId, user.Identity!.Name!, user.FindFirst(ErpClaims.DisplayName)?.Value ?? "",
            stamp, company, false, ip));
        Nav.NavigateTo(company is null ? Auth.CompanyPath : "/");
    }

    private sealed class PasswordInput
    {
        public string Current { get; set; } = "";
        public string New { get; set; } = "";
        public string Repeat { get; set; } = "";
    }
}
