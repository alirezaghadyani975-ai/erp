@page "/fiscal-years/closing"
@using Erp.Accounting.Application.Closing
@inject Backend Backend
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject NavigationManager Nav
@inject Erp.Api.Infrastructure.AppSession Session

<TabTitle Text="بستن سال مالی" />

<MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-3" Spacing="2">
    <MudText Typo="Typo.h5">بستن سال مالی</MudText>
    <MudSpacer />
    <MudSelect T="short?" Label="سال مالی" Value="_yearId" ValueChanged="YearChanged" Variant="Variant.Outlined" Margin="Margin.Dense"
               Dense="true" Style="min-width:160px">
        @foreach (var y in _years)
        {
            <MudSelectItem T="short?" Value="y.Id">@y.Title</MudSelectItem>
        }
    </MudSelect>
    <MudIconButton Icon="@Icons.Material.Outlined.Refresh" OnClick="LoadAsync" aria-label="به‌روزرسانی" />
</MudStack>

<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
    بستن در دو قدم است: «صدور اسناد بستن» سند بستن حساب‌های موقت (درآمد، بهای تمام‌شده و هزینه به سود و زیان جاری) و سند اختتامیه
    را در همین سال و سند افتتاحیه را در سال بعد (با انتقال سود و زیان جاری به انباشته) به‌صورت موقت می‌سازد و سال را قفل می‌کند.
    اسناد را بررسی کنید؛ اگر اصلاحی لازم بود «برگشت» بزنید. با «قطعی کردن» اسناد بستن دائم و سال برای همیشه بسته می‌شود.
</MudText>

@if (_busy)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2" />
}

@if (_status is { } s)
{
    <MudPaper Class="pa-4 mb-3" Elevation="1">
        <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="3">
            <MudText Typo="Typo.h6">سال @s.YearTitle</MudText>
            <MudChip T="string" Color="StageColor(s.Stage)">@StageText(s.Stage)</MudChip>
            <MudText>@(s.NetIncome >= 0 ? "سود سال" : "زیان سال"): <b class="num">@Format.Amount(Math.Abs(s.NetIncome))</b> ریال</MudText>
            @if (s.NextYearTitle is not null)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">سال بعد: @s.NextYearTitle</MudText>
            }
            else if (s.Stage == ClosingStage.Open)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">سال بعد هنوز تعریف نشده و با بستن ساخته می‌شود.</MudText>
            }
            <MudSpacer />
            @if (Session.Has(AccountingPermissions.FiscalClose))
            {
                @switch (s.Stage)
                {
                    case ClosingStage.Open:
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Lock"
                                   Disabled="_busy || s.Blockers.Count > 0" OnClick="CloseAsync">صدور اسناد بستن</MudButton>
                        break;
                    case ClosingStage.Pending:
                        <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Outlined.Undo"
                                   Disabled="_busy" OnClick="UndoAsync">برگشت</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Lock"
                                   Disabled="_busy" OnClick="FinalizeAsync">قطعی کردن بستن سال</MudButton>
                        break;
                }
            }
        </MudStack>

        @if (s.Blockers.Count > 0)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-3">
                پیش از بستن:
                <ul class="guide-list">
                    @foreach (var b in s.Blockers)
                    {
                        <li>@b</li>
                    }
                </ul>
            </MudAlert>
        }
        else if (s.Stage == ClosingStage.Open)
        {
            <MudAlert Severity="Severity.Success" Class="mt-3" Dense="true">همه اسناد دائم‌اند؛ سال آماده بستن است.</MudAlert>
        }
    </MudPaper>

    @if (s.Vouchers.Count > 0)
    {
        <MudTable T="ClosingVoucherDto" Items="s.Vouchers" Dense="true" Hover="true" Elevation="1" OnRowClick="Open" RowStyle="cursor:pointer">
            <HeaderContent>
                <MudTh>سند</MudTh>
                <MudTh>سال</MudTh>
                <MudTh>تاریخ</MudTh>
                <MudTh>ش. موقت</MudTh>
                <MudTh>ش. قطعی</MudTh>
                <MudTh>ردیف</MudTh>
                <MudTh>وضعیت</MudTh>
                <MudTh Style="text-align:left">مبلغ</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd><b>@Format.Type(context.Type)</b></MudTd>
                <MudTd>@context.FiscalYearTitle</MudTd>
                <MudTd><span class="code">@context.Date</span></MudTd>
                <MudTd><span class="code">@context.TempNo</span></MudTd>
                <MudTd><span class="code">@(context.VoucherNo?.ToString() ?? "—")</span></MudTd>
                <MudTd>@context.LineCount</MudTd>
                <MudTd><MudChip T="string" Size="Size.Small" Color="Format.StatusColor(context.Status)">@Format.Status(context.Status)</MudChip></MudTd>
                <MudTd Class="num">@Format.Amount(context.Total)</MudTd>
            </RowTemplate>
        </MudTable>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2 d-block">
            افتتاحیه سال بعد بعد از بستن قطعی هم موقت می‌ماند؛ آن را در سال بعد دائم کنید (شماره ۱ آن سال).
        </MudText>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "year")] public int? Year { get; set; }

    private List<FiscalYearDto> _years = [];
    private short? _yearId;
    private ClosingStatusDto? _status;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        var years = await Backend.Run<FiscalYearService, List<FiscalYearDto>>(s => s.GetAllAsync(default));
        if (!years.Success) { Snackbar.Add(years.Error!, Severity.Error); return; }
        _years = years.Value!;
        // پیش‌فرض: قدیمی‌ترین سالی که هنوز بسته نشده
        _yearId = (_years.FirstOrDefault(y => y.Id == Year) ?? _years.Where(y => y.Status != PeriodStatus.Closed).MinBy(y => y.StartDate)
                   ?? _years.FirstOrDefault())?.Id;
        await LoadAsync();
    }

    private async Task YearChanged(short? id) { _yearId = id; await LoadAsync(); }

    private async Task LoadAsync()
    {
        if (_yearId is not short id) return;
        _busy = true;
        var r = await Backend.Run<ClosingService, ClosingStatusDto>(s => s.StatusAsync(id, default));
        _busy = false;
        if (r.Success) _status = r.Value; else Snackbar.Add(r.Error!, Severity.Error);
    }

    private async Task RunAsync(Func<ClosingService, Task<ClosingStatusDto>> op, string done)
    {
        _busy = true;
        var r = await Backend.Run(op);
        _busy = false;
        if (!r.Success) { Snackbar.Add(r.Error!, Severity.Error); await LoadAsync(); return; }
        _status = r.Value;
        Snackbar.Add(done, Severity.Success);
        var years = await Backend.Run<FiscalYearService, List<FiscalYearDto>>(s => s.GetAllAsync(default));
        if (years.Success) _years = years.Value!;
    }

    private async Task CloseAsync()
    {
        if (!await Dialogs.AskAsync("صدور اسناد بستن", $"اسناد بستن سال {_status!.YearTitle} و افتتاحیه سال بعد صادر و سال قفل شود؟ تا قطعی نکرده‌اید برگشت دارد.", "صدور"))
            return;
        await RunAsync(s => s.CloseAsync(_yearId!.Value, default), "اسناد بستن صادر شد؛ بررسی و سپس قطعی کنید.");
    }

    private async Task UndoAsync()
    {
        if (!await Dialogs.AskAsync("برگشت از بستن", "اسناد بستن، اختتامیه و افتتاحیه سال بعد حذف و سال دوباره باز شود؟", "برگشت"))
            return;
        await RunAsync(s => s.UndoAsync(_yearId!.Value, default), "بستن سال برگشت خورد و سال باز شد.");
    }

    private async Task FinalizeAsync()
    {
        if (!await Dialogs.AskAsync("بستن قطعی", $"اسناد بستن دائم و سال {_status!.YearTitle} برای همیشه بسته شود؟ این کار برگشت ندارد.", "قطعی کن"))
            return;
        await RunAsync(s => s.FinalizeAsync(_yearId!.Value, default), $"سال {_status!.YearTitle} بسته شد.");
    }

    private void Open(TableRowClickEventArgs<ClosingVoucherDto> e) => Nav.NavigateTo($"/vouchers/{e.Item!.Id}");

    private static string StageText(ClosingStage s) => s switch
    {
        ClosingStage.Open => "باز",
        ClosingStage.Pending => "اسناد بستن صادر شده (در انتظار قطعی)",
        _ => "بسته"
    };

    private static Color StageColor(ClosingStage s) => s switch
    {
        ClosingStage.Open => Color.Info,
        ClosingStage.Pending => Color.Warning,
        _ => Color.Success
    };
}
