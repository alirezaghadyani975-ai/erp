@page "/reports/trial-balance"
@inject Backend Backend
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject Erp.Api.Infrastructure.AppSession Session

<TabTitle Text="تراز آزمایشی" />

<MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-3 no-print" Spacing="2">
    <MudText Typo="Typo.h5">تراز آزمایشی</MudText>
    <MudSpacer />
    <MudToggleGroup T="int" @bind-Value="_columns" Color="Color.Primary" Size="Size.Small" Outlined="true" Style="min-width:200px">
        <MudToggleItem Value="4" Text="۴ ستونی" />
        <MudToggleItem Value="6" Text="۶ ستونی" />
    </MudToggleGroup>
    <ExcelButton Build="BuildExcel" Disabled="_result is null" />
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Print" OnClick="Print" Disabled="_result is null">چاپ</MudButton>
</MudStack>

@if (!_loading && _years.Count == 0)
{
    <MudAlert Severity="Severity.Info">
        هنوز سال مالی تعریف نشده است. از صفحه <MudLink Href="/fiscal-years">سال و دوره مالی</MudLink> یک سال بسازید.
    </MudAlert>
    return;
}

<ReportFilterBar Model="_filter" Years="_years">
    <MudItem xs="6" sm="4" md="2">
        <MudSelect T="TrialBalanceLevel" Label="سطح" Value="_level" ValueChanged="LevelChanged"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
            @foreach (var l in Enum.GetValues<TrialBalanceLevel>())
            {
                <MudSelectItem T="TrialBalanceLevel" Value="l">@LevelText(l)</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    @if (_level == TrialBalanceLevel.Detail)
    {
        <MudItem xs="6" sm="4" md="3">
            <MudSelect T="short?" Label="نوع تفصیلی" @bind-Value="_detailTypeId" Clearable="true"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                @foreach (var t in _detailTypes)
                {
                    <MudSelectItem T="short?" Value="t.Id">@t.Title</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
    }
    <MudItem xs="6" sm="4" md="2">
        <MudCheckBox @bind-Value="_hideZero" Label="بدون حساب‌های صفر" Dense="true" Color="Color.Primary" />
    </MudItem>
    <MudItem xs="12" sm="4" md="2">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow"
                   OnClick="Reload" Disabled="_running || _filter.YearId is null" FullWidth="true">نمایش</MudButton>
    </MudItem>
</ReportFilterBar>

@if (_path.Count > 0)
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-2 no-print" Wrap="Wrap.Wrap">
        <MudText Typo="Typo.body2" Color="Color.Secondary">مسیر:</MudText>
        @for (var i = 0; i < _path.Count; i++)
        {
            var index = i;
            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => Back(index)">@_path[index].Label</MudButton>
            <MudIcon Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" />
        }
        <MudText Typo="Typo.body2"><b>@_currentLabel</b></MudText>
    </MudStack>
}

@if (_result is not null)
{
    <div class="report-head">
        <MudText Typo="Typo.h6">تراز آزمایشی @LevelText(_result.Level) @(_currentLabel is null ? "" : $"— {_currentLabel}")</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            از <span class="code">@_result.FromDate</span> تا <span class="code">@_result.ToDate</span>
            @(_filter.IncludeTemporary ? "— اسناد موقت و دائم" : "— فقط اسناد دائم")
        </MudText>
    </div>

    <MudTable T="TrialBalanceRow" Items="_result.Rows" Dense="true" Hover="true" Bordered="true" Elevation="1"
              Loading="_running" CustomHeader="true" CustomFooter="true" OnRowClick="RowClicked"
              RowStyle="cursor:pointer" Class="report-table" HorizontalScrollbar="true">
        <HeaderContent>
            <MudTHeadRow>
                <MudTh rowspan="2">کد</MudTh>
                <MudTh rowspan="2">عنوان</MudTh>
                @if (_result.Level == TrialBalanceLevel.Detail)
                {
                    <MudTh rowspan="2">نوع</MudTh>
                }
                @if (_columns == 6)
                {
                    <MudTh colspan="2" Class="group-head">مانده ابتدای دوره</MudTh>
                    <MudTh colspan="2" Class="group-head">گردش طی دوره</MudTh>
                }
                else
                {
                    <MudTh colspan="2" Class="group-head">گردش</MudTh>
                }
                <MudTh colspan="2" Class="group-head">مانده پایان دوره</MudTh>
                <MudTh rowspan="2" Class="no-print"></MudTh>
            </MudTHeadRow>
            <MudTHeadRow>
                @for (var i = 0; i < _columns / 2; i++)
                {
                    <MudTh Class="num-head">بدهکار</MudTh>
                    <MudTh Class="num-head">بستانکار</MudTh>
                }
            </MudTHeadRow>
        </HeaderContent>
        <RowTemplate>
            <MudTd><span class="code">@context.Code</span></MudTd>
            <MudTd>@context.Title</MudTd>
            @if (_result.Level == TrialBalanceLevel.Detail)
            {
                <MudTd><MudText Typo="Typo.caption">@context.DetailTypeTitle</MudText></MudTd>
            }
            @if (_columns == 6)
            {
                <MudTd Class="num">@Amount(context.OpeningDebit)</MudTd>
                <MudTd Class="num">@Amount(context.OpeningCredit)</MudTd>
                <MudTd Class="num">@Amount(context.PeriodDebit)</MudTd>
                <MudTd Class="num">@Amount(context.PeriodCredit)</MudTd>
            }
            else
            {
                <MudTd Class="num">@Amount(context.TotalDebit)</MudTd>
                <MudTd Class="num">@Amount(context.TotalCredit)</MudTd>
            }
            <MudTd Class="num"><b>@Amount(context.EndingDebit)</b></MudTd>
            <MudTd Class="num"><b>@Amount(context.EndingCredit)</b></MudTd>
            <MudTd Class="no-print" Style="white-space:nowrap">
                @if (context.Level == TrialBalanceLevel.Subsidiary)
                {
                    <span @onclick:stopPropagation="true">
                        <MudTooltip Text="تراز تفصیلی این معین">
                            <MudIconButton Icon="@Icons.Material.Outlined.AccountTree" Size="Size.Small"
                                           OnClick="() => DetailsOf(context)" aria-label="تفصیلی‌ها" />
                        </MudTooltip>
                    </span>
                }
                <MudTooltip Text="@(context.HasChildren ? "زیرمجموعه" : "دفتر")">
                    <MudIcon Icon="@(context.HasChildren ? Icons.Material.Filled.ChevronLeft : Icons.Material.Outlined.MenuBook)"
                             Size="Size.Small" Color="Color.Primary" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
        <FooterContent>
            <MudTFootRow Class="total-row">
                <MudTd colspan="@(_result.Level == TrialBalanceLevel.Detail ? 3 : 2)">
                    جمع
                    @if (_result.Level != TrialBalanceLevel.Detail && _accountCode is null)
                    {
                        @if (_result.IsBalanced)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Class="mr-2">تراز است</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Error" Class="mr-2">تراز نیست</MudChip>
                        }
                    }
                </MudTd>
                @if (_columns == 6)
                {
                    <MudTd Class="num">@Format.Amount(_result.Totals.OpeningDebit)</MudTd>
                    <MudTd Class="num">@Format.Amount(_result.Totals.OpeningCredit)</MudTd>
                    <MudTd Class="num">@Format.Amount(_result.Totals.PeriodDebit)</MudTd>
                    <MudTd Class="num">@Format.Amount(_result.Totals.PeriodCredit)</MudTd>
                }
                else
                {
                    <MudTd Class="num">@Format.Amount(_result.Totals.TotalDebit)</MudTd>
                    <MudTd Class="num">@Format.Amount(_result.Totals.TotalCredit)</MudTd>
                }
                <MudTd Class="num">@Format.Amount(_result.Totals.EndingDebit)</MudTd>
                <MudTd Class="num">@Format.Amount(_result.Totals.EndingCredit)</MudTd>
                <MudTd Class="no-print"></MudTd>
            </MudTFootRow>
        </FooterContent>
        <NoRecordsContent><MudText Class="pa-4">در این بازه گردشی نیست.</MudText></NoRecordsContent>
    </MudTable>

    @if (_result.Level == TrialBalanceLevel.Detail)
    {
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2 d-block no-print">
            در تراز تفصیلی، ردیف‌های بدون تفصیلی نمی‌آیند و ردیفی که چند تفصیلی دارد برای هر کدام حساب می‌شود؛ پس جمع آن لزوماً تراز نیست.
        </MudText>
    }
}

@code {
    private sealed record PathStep(TrialBalanceLevel Level, string? AccountCode, string Label);

    private readonly ReportFilterModel _filter = new();
    private List<FiscalYearDto> _years = [];
    private List<DetailTypeDto> _detailTypes = [];
    private TrialBalanceLevel _level = TrialBalanceLevel.Subsidiary;
    private string? _accountCode;
    private string? _currentLabel;
    private short? _detailTypeId;
    private bool _hideZero = true;
    private int _columns = 6;
    private readonly List<PathStep> _path = [];
    private TrialBalanceDto? _result;
    private bool _loading = true;
    private bool _running;

    protected override async Task OnInitializedAsync()
    {
        var years = await Backend.Run<FiscalYearService, List<FiscalYearDto>>(s => s.GetAllAsync(default));
        var types = await Backend.Run<DetailService, List<DetailTypeDto>>(s => s.GetTypesAsync(default));
        _loading = false;
        if (!years.Success) { Snackbar.Add(years.Error!, Severity.Error); return; }
        _years = years.Value!;
        _detailTypes = types.Value ?? [];
        _filter.SetYear(_years.FirstOrDefault());
        if (_filter.YearId is not null) await RunAsync();
    }

    private static string LevelText(TrialBalanceLevel l) => l switch
    {
        TrialBalanceLevel.Group => "گروه",
        TrialBalanceLevel.General => "کل",
        TrialBalanceLevel.Subsidiary => "معین",
        TrialBalanceLevel.Detail => "تفصیلی",
        _ => l.ToString()
    };

    private static string Amount(decimal v) => v == 0 ? "" : Format.Amount(v);

    private async Task LevelChanged(TrialBalanceLevel level)
    {
        _level = level;
        _accountCode = null;
        _currentLabel = null;
        _path.Clear();
        await RunAsync();
    }

    private Task Reload() => RunAsync();

    private async Task RunAsync()
    {
        if (_filter.YearId is null) return;
        _running = true;
        var request = new TrialBalanceRequest(_filter.ToFilter(), _level, _accountCode,
            _level == TrialBalanceLevel.Detail ? _detailTypeId : null, null, _hideZero);
        var result = await Backend.Run<ReportService, TrialBalanceDto>(s => s.TrialBalanceAsync(request, default));
        _running = false;
        if (result.Success) _result = result.Value;
        else Snackbar.Add(result.Error!, Severity.Error);
    }

    private async Task RowClicked(TableRowClickEventArgs<TrialBalanceRow> args)
    {
        var row = args.Item!;
        switch (row.Level)
        {
            case TrialBalanceLevel.Group:
                await DrillAsync(TrialBalanceLevel.General, row.Code, $"گروه {row.Code} {row.Title}");
                break;
            case TrialBalanceLevel.General:
                await DrillAsync(TrialBalanceLevel.Subsidiary, row.Code, $"کل {row.Code} {row.Title}");
                break;
            case TrialBalanceLevel.Subsidiary:
                OpenLedger(row.Code, null);
                break;
            case TrialBalanceLevel.Detail:
                OpenLedger(_accountCode, row.DetailId);
                break;
        }
    }

    private Task DetailsOf(TrialBalanceRow row) =>
        DrillAsync(TrialBalanceLevel.Detail, row.Code, $"معین {row.Code} {row.Title}");

    private async Task DrillAsync(TrialBalanceLevel level, string accountCode, string label)
    {
        _path.Add(new PathStep(_level, _accountCode, _currentLabel ?? $"همه ({LevelText(_level)})"));
        _level = level;
        _accountCode = accountCode;
        _currentLabel = label;
        await RunAsync();
    }

    private async Task Back(int index)
    {
        var step = _path[index];
        _path.RemoveRange(index, _path.Count - index);
        _level = step.Level;
        _accountCode = step.AccountCode;
        _currentLabel = step.AccountCode is null ? null : step.Label;
        await RunAsync();
    }

    private void OpenLedger(string? accountCode, int? detailId)
    {
        var query = _filter.ToQuery();
        query["account"] = accountCode;
        query["detail"] = detailId;
        Nav.NavigateTo(Nav.GetUriWithQueryParameters("/reports/ledger", query));
    }

    private async Task Print() => await JS.InvokeVoidAsync("print");

    private ExcelFile? BuildExcel()
    {
        if (_result is null) return null;
        var columns = new List<ExcelColumn<TrialBalanceRow>>
        {
            new("کد", r => r.Code, ExcelKind.Code),
            new("عنوان", r => r.Title),
        };
        if (_result.Level == TrialBalanceLevel.Detail) columns.Add(new("نوع تفصیلی", r => r.DetailTypeTitle));
        if (_columns == 6)
        {
            columns.Add(new("مانده ابتدا - بدهکار", r => r.OpeningDebit, ExcelKind.Amount));
            columns.Add(new("مانده ابتدا - بستانکار", r => r.OpeningCredit, ExcelKind.Amount));
            columns.Add(new("گردش دوره - بدهکار", r => r.PeriodDebit, ExcelKind.Amount));
            columns.Add(new("گردش دوره - بستانکار", r => r.PeriodCredit, ExcelKind.Amount));
        }
        else
        {
            columns.Add(new("گردش بدهکار", r => r.TotalDebit, ExcelKind.Amount));
            columns.Add(new("گردش بستانکار", r => r.TotalCredit, ExcelKind.Amount));
        }
        columns.Add(new("مانده بدهکار", r => r.EndingDebit, ExcelKind.Amount));
        columns.Add(new("مانده بستانکار", r => r.EndingCredit, ExcelKind.Amount));
        var title = $"تراز آزمایشی {_columns} ستونی {LevelText(_result.Level)}";
        return ExcelExport.Build(title,
            ReportHeader.Lines(Session, _result.FromDate, _result.ToDate, _filter.IncludeTemporary, _currentLabel),
            columns, _result.Rows, _result.Totals);
    }
}
