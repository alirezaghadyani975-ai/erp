@page "/persons"
@inject Backend Backend
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>اشخاص</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-3" Spacing="2">
    <MudText Typo="Typo.h5">اشخاص</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Label" OnClick="() => _rolesOpen = true">نقش‌ها</MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" Href="/persons/new">
        شخص جدید
    </MudButton>
</MudStack>

<MudPaper Class="pa-3" Elevation="1">
    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="mb-2">
        <MudTextField T="string" Value="_search" ValueChanged="SearchChanged" Immediate="true" DebounceInterval="300"
                      Placeholder="نام، کد ملی، موبایل یا کد تفصیلی" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" Clearable="true"
                      Style="min-width:280px" />
        <MudSelect T="short?" Label="نقش" Value="_roleFilter" ValueChanged="RoleFilterChanged" Clearable="true"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="min-width:180px">
            @foreach (var r in _roles.Where(r => r.IsActive))
            {
                <MudSelectItem T="short?" Value="r.Id">@r.Title</MudSelectItem>
            }
        </MudSelect>
        <MudCheckBox T="bool" Value="_includeInactive" ValueChanged="InactiveChanged" Label="غیرفعال‌ها هم" Dense="true" />
    </MudStack>

    <MudTable T="PersonListItemDto" Items="_persons" Dense="true" Hover="true" Elevation="0" Loading="_loading"
              OnRowClick="@(a => Nav.NavigateTo($"/persons/{a.Item!.Id}"))" RowStyle="cursor:pointer">
        <HeaderContent>
            <MudTh>تفصیلی</MudTh>
            <MudTh>نام</MudTh>
            <MudTh>نوع</MudTh>
            <MudTh>کد / شناسه ملی</MudTh>
            <MudTh>موبایل</MudTh>
            <MudTh>نقش‌ها</MudTh>
            <MudTh>کد کارمند</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd><span class="code">@(context.DetailCode ?? "—")</span></MudTd>
            <MudTd>
                @context.DisplayName
                @if (!context.IsActive)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default">غیرفعال</MudChip>
                }
            </MudTd>
            <MudTd>@Titles.Of(context.Kind)</MudTd>
            <MudTd><span class="code">@context.NationalId</span></MudTd>
            <MudTd><span class="code">@context.Mobile</span></MudTd>
            <MudTd>
                @foreach (var r in context.Roles)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">@r</MudChip>
                }
            </MudTd>
            <MudTd><span class="code">@context.EmployeeDetailCode</span></MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText Class="pa-4">شخصی پیدا نشد.</MudText></NoRecordsContent>
    </MudTable>
</MudPaper>

<MudDialog @bind-Visible="_rolesOpen" Options="new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true }">
    <TitleContent><MudText Typo="Typo.h6">نقش‌های اشخاص</MudText></TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
            نقش فقط برچسب است و کد تفصیلی شخص را عوض نمی‌کند؛ در قواعد تفصیلی هر معین، نقش‌ها فهرست اشخاص فرم سند را فیلتر می‌کنند.
            نقش «کارمند» تفصیلی جدا در گروه کارکنان می‌سازد.
        </MudText>
        <MudSimpleTable Dense="true" Elevation="0">
            <tbody>
                @foreach (var r in _roles)
                {
                    <tr>
                        <td>@r.Title</td>
                        <td>@(r.IsSystem ? "سیستمی" : "تعریف کاربر")</td>
                        <td style="text-align:left">
                            @if (!r.IsSystem)
                            {
                                <MudSwitch T="bool" Value="r.IsActive" ValueChanged="v => ToggleRole(r, v)" Color="Color.Primary"
                                           Label="@(r.IsActive ? "فعال" : "غیرفعال")" />
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mt-3">
            <MudTextField T="string" @bind-Value="_newRole" Label="نقش جدید (مثلاً نماینده فروش)"
                          Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddRole" Disabled="string.IsNullOrWhiteSpace(_newRole)">افزودن</MudButton>
        </MudStack>
    </DialogContent>
</MudDialog>

@code {
    private List<PersonListItemDto> _persons = [];
    private List<PersonRoleTypeDto> _roles = [];
    private string? _search;
    private short? _roleFilter;
    private bool _includeInactive;
    private bool _loading = true;
    private bool _rolesOpen;
    private string? _newRole;

    protected override async Task OnInitializedAsync()
    {
        await LoadRolesAsync();
        await LoadAsync();
    }

    private async Task LoadRolesAsync() =>
        _roles = (await Backend.Run<PersonService, List<PersonRoleTypeDto>>(s => s.GetRoleTypesAsync(true, default))).Value ?? [];

    private async Task SearchChanged(string? term) { _search = term; await LoadAsync(); }

    private async Task RoleFilterChanged(short? role) { _roleFilter = role; await LoadAsync(); }

    private async Task InactiveChanged(bool v) { _includeInactive = v; await LoadAsync(); }

    private async Task LoadAsync()
    {
        _loading = true;
        var r = await Backend.Run<PersonService, List<PersonListItemDto>>(s => s.SearchAsync(_search, _roleFilter, _includeInactive, default));
        if (r.Success) _persons = r.Value!; else Snackbar.Add(r.Error!, Severity.Error);
        _loading = false;
    }

    private async Task AddRole()
    {
        var r = await Backend.Run<PersonService, short>(s => s.CreateRoleTypeAsync(_newRole!, default));
        if (!r.Success) { Snackbar.Add(r.Error!, Severity.Error); return; }
        _newRole = null;
        await LoadRolesAsync();
    }

    private async Task ToggleRole(PersonRoleTypeDto role, bool active)
    {
        var r = await Backend.Run<PersonService>(s => s.UpdateRoleTypeAsync(role.Id, role.Title, active, default));
        if (!r.Success) Snackbar.Add(r.Error!, Severity.Error);
        await LoadRolesAsync();
    }
}
