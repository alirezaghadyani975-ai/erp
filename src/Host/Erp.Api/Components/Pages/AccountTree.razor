@page "/accounts"
@inject Backend Backend
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<PageTitle>کدینگ حساب‌ها</PageTitle>

<MudText Typo="Typo.h5" Class="mb-3">کدینگ حساب‌ها</MudText>

<MudGrid Spacing="3">
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-3" Elevation="1">
            <MudTextField T="string" @bind-Value="_filter" Immediate="true" DebounceInterval="200"
                          Placeholder="جستجوی کد یا عنوان حساب" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" Clearable="true" Class="mb-2" />
            <div style="max-height:70vh; overflow:auto">
                @foreach (var root in _tree)
                {
                    @Node(root)
                }
            </div>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        @if (_selected is null)
        {
            <MudAlert Severity="Severity.Info">یک حساب را از درخت انتخاب کنید.</MudAlert>
        }
        else
        {
            var a = _selected;
            <MudPaper Class="pa-4 mb-3" Elevation="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                    <MudText Typo="Typo.h6"><span class="code">@a.Code</span> — @a.Title</MudText>
                    <MudChip T="string" Size="Size.Small">@Format.Level(a.Level)</MudChip>
                    @if (a.IsStandard) { <MudChip T="string" Size="Size.Small" Color="Color.Info">استاندارد</MudChip> }
                    else { <MudChip T="string" Size="Size.Small" Color="Color.Secondary">اختصاصی</MudChip> }
                </MudStack>
                @if (a.Level == AccountLevel.Subsidiary)
                {
                    <MudText Typo="Typo.body2" Class="mb-3">ماهیت: @Format.Nature(a.Nature) · نوع: @Format.AccountTypeText(a.Type)</MudText>
                }
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <MudTextField T="string" Label="عنوان" @bind-Value="_editTitle" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudSwitch T="bool" @bind-Value="_editActive" Color="Color.Primary" Label="فعال" />
                    <MudButton Variant="Variant.Outlined" OnClick="SaveAccountAsync" Disabled="_busy">ذخیره</MudButton>
                    @if (!a.IsStandard)
                    {
                        <MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" OnClick="DeleteAccountAsync" Disabled="_busy" aria-label="حذف حساب" />
                    }
                </MudStack>
                @if (a.IsStandard)
                {
                    <MudText Typo="Typo.caption" Class="mt-1">حساب استاندارد قفل است: کدش تغییر نمی‌کند و حذف نمی‌شود.</MudText>
                }
            </MudPaper>

            @if (a.Level == AccountLevel.Subsidiary)
            {
                <MudPaper Class="pa-4 mb-3" Elevation="1">
                    <MudText Typo="Typo.subtitle1" Class="mb-1"><b>تفصیلی‌های مجاز این معین</b></MudText>
                    <MudText Typo="Typo.body2" Class="mb-3">
                        برای هر سطح، گروه‌های تفصیلی که در سند قابل انتخاب‌اند و الزامی بودن آن. برای گروه اشخاص، «نقش‌های مجاز»
                        فهرست اشخاص فرم سند را فیلتر می‌کند (مثلاً فقط مشتریان)؛ کاربر در صورت نیاز می‌تواند همه اشخاص را ببیند.
                    </MudText>
                    @foreach (var level in _levels)
                    {
                        <MudPaper Outlined="true" Class="pa-2 mb-2">
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                <MudText Style="min-width:60px"><b>سطح @level.LevelNo</b></MudText>
                                <MudSelect T="short" MultiSelection="true" @bind-SelectedValues="level.TypeIds" Label="گروه‌های تفصیلی مجاز"
                                           Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="min-width:240px"
                                           MultiSelectionTextFunc="@(vals => string.Join("، ", vals.Select(v => TypeTitle(short.Parse(v!)))))">
                                    @foreach (var t in _types.Where(t => t.IsActive || level.TypeIds.Contains(t.Id)))
                                    {
                                        <MudSelectItem T="short" Value="t.Id">@t.Title (<span class="code">@t.CodeFrom</span>)</MudSelectItem>
                                    }
                                </MudSelect>
                                @if (level.TypeIds.Any(IsPersonsType))
                                {
                                    <MudSelect T="short" MultiSelection="true" @bind-SelectedValues="level.RoleIds" Label="نقش‌های مجاز (فیلتر فهرست)"
                                               Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="min-width:200px"
                                               HelperText="خالی = همه اشخاص"
                                               MultiSelectionTextFunc="@(vals => string.Join("، ", vals.Select(v => RoleTitle(short.Parse(v!)))))">
                                        @foreach (var r in _roles.Where(r => r.IsActive || level.RoleIds.Contains(r.Id)))
                                        {
                                            <MudSelectItem T="short" Value="r.Id">@r.Title</MudSelectItem>
                                        }
                                    </MudSelect>
                                }
                                <MudCheckBox T="bool" @bind-Value="level.IsRequired" Label="الزامی" />
                                <MudIconButton Icon="@Icons.Material.Filled.Save" Color="Color.Primary" OnClick="() => SaveLevelAsync(level)" Disabled="_busy" aria-label="ذخیره سطح" />
                                @if (level == _levels.Last() && level.Saved)
                                {
                                    <MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" OnClick="() => RemoveLevelAsync(level)" Disabled="_busy" aria-label="حذف سطح" />
                                }
                            </MudStack>
                        </MudPaper>
                    }
                    @if (_levels.Count < 6 && _levels.All(l => l.Saved))
                    {
                        <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="AddLevel">افزودن سطح @(_levels.Count + 1)</MudButton>
                    }
                </MudPaper>
            }
            else
            {
                <MudPaper Class="pa-4 mb-3" Elevation="1">
                    <MudText Typo="Typo.subtitle1" Class="mb-3"><b>افزودن @(a.Level == AccountLevel.Group ? "کل" : "معین") اختصاصی زیر این حساب</b></MudText>
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="4">
                            <MudTextField T="string" Label="کد" @bind-Value="_newCode" Variant="Variant.Outlined" Margin="Margin.Dense" Class="code"
                                          HelperText="@($"با {a.Code} شروع شود")" />
                        </MudItem>
                        <MudItem xs="12" sm="8">
                            <MudTextField T="string" Label="عنوان" @bind-Value="_newTitle" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        @if (a.Level == AccountLevel.General)
                        {
                            <MudItem xs="12" sm="6">
                                <MudSelect T="AccountNature?" Label="ماهیت" @bind-Value="_newNature" Variant="Variant.Outlined" Margin="Margin.Dense">
                                    @foreach (var n in Enum.GetValues<AccountNature>())
                                    {
                                        <MudSelectItem T="AccountNature?" Value="n">@Format.Nature(n)</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                        }
                    </MudGrid>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" OnClick="CreateAccountAsync" Disabled="_busy">افزودن حساب</MudButton>
                </MudPaper>
            }
        }
    </MudItem>
</MudGrid>

@code {
    private List<AccountNodeDto> _tree = [];
    private List<DetailTypeDto> _types = [];
    private List<PersonRoleTypeDto> _roles = [];
    private readonly HashSet<int> _expanded = [];
    private string? _filter;
    private AccountDto? _selected;
    private string? _editTitle;
    private bool _editActive;
    private List<LevelModel> _levels = [];
    private string? _newCode, _newTitle;
    private AccountNature? _newNature;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        _types = (await Backend.Run<DetailService, List<DetailTypeDto>>(s => s.GetTypesAsync(default))).Value ?? [];
        _roles = (await Backend.Run<PersonService, List<PersonRoleTypeDto>>(s => s.GetRoleTypesAsync(true, default))).Value ?? [];
        await LoadTreeAsync();
    }

    private async Task LoadTreeAsync()
    {
        var r = await Backend.Run<AccountService, List<AccountNodeDto>>(s => s.GetTreeAsync(default));
        if (r.Success) _tree = r.Value!;
        else Snackbar.Add(r.Error!, Severity.Error);
    }

    private string TypeTitle(short id) => _types.FirstOrDefault(t => t.Id == id)?.Title ?? id.ToString();

    private string RoleTitle(short id) => _roles.FirstOrDefault(r => r.Id == id)?.Title ?? id.ToString();

    private bool IsPersonsType(short id) => _types.FirstOrDefault(t => t.Id == id)?.OwnerModule == OwnerModules.Persons;

    private bool Matches(AccountNodeDto n)
    {
        if (string.IsNullOrWhiteSpace(_filter)) return true;
        var f = Erp.SharedKernel.Text.PersianText.Normalize(_filter);
        return n.Code.StartsWith(f) || n.Title.Contains(f) || n.Children.Any(Matches);
    }

    private RenderFragment Node(AccountNodeDto n) => __builder =>
    {
        if (!Matches(n)) return;
        var hasChildren = n.Children.Count > 0;
        var expanded = _expanded.Contains(n.Id) || !string.IsNullOrWhiteSpace(_filter);
        <div class="tree-node @(_selected?.Id == n.Id ? "selected" : "") @(n.IsActive ? "" : "tree-inactive")" @onclick="() => SelectAsync(n)">
            @if (hasChildren)
            {
                <span @onclick="() => Toggle(n.Id)" @onclick:stopPropagation="true" style="display:inline-flex">
                    <MudIcon Icon="@(expanded ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronLeft)" Size="Size.Small" />
                </span>
            }
            else
            {
                <span style="width:20px"></span>
            }
            <span class="code" style="min-width:42px">@n.Code</span>
            <span>@n.Title</span>
            @if (!n.IsStandard) { <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Class="ma-0">اختصاصی</MudChip> }
        </div>
        @if (hasChildren && expanded)
        {
            <div class="tree-children">
                @foreach (var c in n.Children) { @Node(c) }
            </div>
        }
    };

    private void Toggle(int id)
    {
        if (!_expanded.Remove(id)) _expanded.Add(id);
    }

    private async Task SelectAsync(AccountNodeDto n)
    {
        if (n.Children.Count > 0) _expanded.Add(n.Id);
        var r = await Backend.Run<AccountService, AccountDto>(s => s.GetAsync(n.Id, default));
        if (!r.Success) { Snackbar.Add(r.Error!, Severity.Error); return; }
        SetSelected(r.Value!);
    }

    private void SetSelected(AccountDto a)
    {
        _selected = a;
        _editTitle = a.Title;
        _editActive = a.IsActive;
        _levels = a.DetailLevels.Select(l => new LevelModel(l.LevelNo) { IsRequired = l.IsRequired, TypeIds = l.DetailTypeIds.ToHashSet(), RoleIds = l.RoleIds.ToHashSet(), Saved = true }).ToList();
        _newCode = a.Code;
        _newTitle = null;
        _newNature = null;
    }

    private async Task ReloadSelectedAsync()
    {
        var r = await Backend.Run<AccountService, AccountDto>(s => s.GetAsync(_selected!.Id, default));
        if (r.Success) SetSelected(r.Value!);
    }

    private async Task SaveAccountAsync() => await Busy(async () =>
    {
        var r = await Backend.Run<AccountService>(s => s.UpdateAsync(_selected!.Id, new UpdateAccountRequest(_editTitle ?? "", _editActive), default));
        if (!r.Success) { Snackbar.Add(r.Error!, Severity.Error); return; }
        Snackbar.Add("حساب ذخیره شد.", Severity.Success);
        await LoadTreeAsync();
        await ReloadSelectedAsync();
    });

    private async Task DeleteAccountAsync()
    {
        var a = _selected!;
        if (!await Dialogs.DeleteAsync($"حساب {a.Code} «{a.Title}»", "حساب دارای زیرحساب یا گردش حذف نمی‌شود؛ غیرفعالش کنید.")) return;
        await Busy(async () =>
        {
            var r = await Backend.Run<AccountService>(s => s.DeleteAsync(a.Id, default));
            if (!r.Success) { Snackbar.Add(r.Error!, Severity.Error); return; }
            Snackbar.Add("حساب حذف شد.", Severity.Success);
            _selected = null;
            await LoadTreeAsync();
        });
    }

    private void AddLevel() => _levels.Add(new LevelModel(_levels.Count + 1) { IsRequired = true });

    private async Task SaveLevelAsync(LevelModel level) => await Busy(async () =>
    {
        var r = await Backend.Run<AccountService>(s => s.SetDetailLevelAsync(_selected!.Id, level.LevelNo,
            new SetDetailLevelRequest(level.IsRequired, level.TypeIds.ToList(),
                level.TypeIds.Any(IsPersonsType) ? level.RoleIds.ToList() : []), default));
        if (!r.Success) { Snackbar.Add(r.Error!, Severity.Error); return; }
        Snackbar.Add($"سطح {level.LevelNo} ذخیره شد.", Severity.Success);
        await ReloadSelectedAsync();
    });

    private async Task RemoveLevelAsync(LevelModel level) => await Busy(async () =>
    {
        var r = await Backend.Run<AccountService>(s => s.RemoveDetailLevelAsync(_selected!.Id, level.LevelNo, default));
        if (!r.Success) { Snackbar.Add(r.Error!, Severity.Error); return; }
        Snackbar.Add($"سطح {level.LevelNo} حذف شد.", Severity.Success);
        await ReloadSelectedAsync();
    });

    private async Task CreateAccountAsync() => await Busy(async () =>
    {
        var request = new CreateAccountRequest(_selected!.Id, _newCode ?? "", _newTitle ?? "", _newNature, null);
        var r = await Backend.Run<AccountService, int>(s => s.CreateAsync(request, default));
        if (!r.Success) { Snackbar.Add(r.Error!, Severity.Error); return; }
        Snackbar.Add("حساب اختصاصی اضافه شد.", Severity.Success);
        _expanded.Add(_selected.Id);
        await LoadTreeAsync();
        var created = await Backend.Run<AccountService, AccountDto>(s => s.GetAsync(r.Value, default));
        if (created.Success) SetSelected(created.Value!);
    });

    private async Task Busy(Func<Task> action)
    {
        if (_busy) return;
        _busy = true;
        try { await action(); } finally { _busy = false; }
    }

    private sealed class LevelModel(int levelNo)
    {
        public int LevelNo { get; } = levelNo;
        public bool IsRequired { get; set; }
        public IReadOnlyCollection<short> TypeIds { get; set; } = new HashSet<short>();
        public IReadOnlyCollection<short> RoleIds { get; set; } = new HashSet<short>();
        public bool Saved { get; set; }
    }
}
